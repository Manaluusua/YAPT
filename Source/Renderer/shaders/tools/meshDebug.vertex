#include "../globalDefinitions.hlsl"

struct ObjectData
{
	float4x4 mvpMat;
};

ConstantBuffer<ObjectData> g_ObjectData : register(b0, space0);

struct VertexInput
{
    float3 position : POSITION;
	float3 normal : NORMAL0;
	float3 tangent : TANGENT0;
	float2 uv : TEXCOORD0;

	
};
 
struct VertexOutput
{
    float4 position : SV_Position;
	float3 color : COLOR0;

};
 
VertexOutput main(VertexInput input)
{
    VertexOutput output;
    output.position = mul( g_ObjectData.mvpMat, float4(input.position, 1.0f));
	output.color = input.normal.xyz;
    return output;
}