[numthreads(64, 1, 1)]
void traceLightRays( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
	//could potentially remove this check here and just not write path if we can't reserve a header. This way we maybe end up with more valid paths per sample run
	if(g_lightPathsPerDim.x <= dispatchThreadId.x || g_lightPathsPerDim.y <= dispatchThreadId.y) return; 

	SpectralSamples radiance;
	float3 lightPos;
	float3 lightDir;
	
	LightPathNode nodes[2] = {(LightPathNode)0, (LightPathNode)0};
	float pdfForward;

	float3 rayDir;
    float3 rayOrigin;

	
    RandomSampler rand;
    rand.init(g_lightPathRandomDimensionOffset,  dispatchThreadId.y * g_lightPathsPerDim.x + dispatchThreadId.x); //TODO: init properly
	g_spectralMainSampleWavelength = calculateSpectralSampleWavelength(rand.getRandom1());

	//sample light
	{
		float4 randomSamples0 = rand.getRandom4();
		float4 randomSamples1 = rand.getRandom4();
		bool sampledEnvironment;
		float3 lightNormal;
		float lightSamplePDF;
		float lightPosPDF;
		float lightDirPDF;
		uint InstanceID;
		uint primitiveIndex;
        sampleLightOrEnv(randomSamples1.w, randomSamples0, randomSamples1.xy, g_sampleEnvLightProbabilityWeight, radiance, lightPos, lightDir, lightNormal,  lightPosPDF, lightDirPDF, lightSamplePDF, sampledEnvironment, InstanceID, primitiveIndex);

		if (radiance.allSamplesEqual(0.f) || lightPosPDF == 0 || lightDirPDF == 0 || lightSamplePDF == 0)
        return;

		radiance = radiance;

		nodes[0].instanceIndex = InstanceID;
		nodes[0].primitiveIndex = primitiveIndex;
		nodes[0].barycentrics = -1;
		nodes[0].normalWS = lightNormal;
		nodes[0].nextIndex = INVALID_LIGHT_NODE_INDEX;
		nodes[0].radiance = radiance.toFloat4();
		nodes[0].positionWS = lightPos;
		nodes[0].pdfForwardMIS = lightPosPDF * lightSamplePDF;
		nodes[0].flags = sampledEnvironment ? LIGHT_PATH_NODE_FLAG_ENV_LIGHT : 0;
		nodes[0].iorPrevious = IOR_DEFAULT;
		nodes[0].iorCurrent = IOR_DEFAULT;
		pdfForward = lightDirPDF;

		rayDir = lightDir;
		rayOrigin = lightPos + getRaySpawnOffsetUsingNormal(lightNormal, lightDir);

		radiance = radiance * abs(dot(lightNormal, lightDir)) / (lightSamplePDF * lightPosPDF * lightDirPDF);
		
    }

    uint lastVertexOffset = INVALID_LIGHT_NODE_INDEX;
    uint lightNodeCount = 1;
	//reserve header early
    uint headerOffset = reserveLightPathHeader();

	if((g_lightPathsPerDim.y * g_lightPathsPerDim.x) <= headerOffset) return;

	BDPTRayState rayState;
    rayState.setStateFlags(0);
    rayState.numberVolumesEntered = 0;


	for(uint i = 1; i < g_maxVerticesPerLightPath; ++i)
	{
		float4 randomSamples0 = rand.getRandom4();

		uint rayFlags = RAY_FLAG_NONE;
		uint InstanceInclusionMask = ~0;

		RayQuery<RAY_FLAG_NONE> q;

		RayDesc ray;
		ray.Origin = rayOrigin;
		ray.Direction = rayDir;
		ray.TMin = DEFAULT_RAY_MIN_T;
		ray.TMax = DEFAULT_RAY_MAX_T;

		q.TraceRayInline(
		    g_accelerationStructure,
		    rayFlags, 
		    InstanceInclusionMask,
		    ray);

		while(q.Proceed());

		if(q.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
		{
			
			uint currentNodeIndex = i & 0x1;
			uint previousNodeIndex = ((i-1)) & 0x1;

            SurfaceDefinition surfaceDef;
            PrecalculatedSurfaceData precalculatedSurfaceData;
            float samplingProbabilities[LAYER_COUNT];
            bool triangleHitFrontFace = q.CommittedTriangleFrontFace();
            float3 woOS = normalize(-q.CommittedObjectRayDirection());
            uint instId = q.CommittedInstanceID();
            uint primIndex = q.CommittedPrimitiveIndex();
            float2 bary = q.CommittedTriangleBarycentrics();

			uint lightNodeFlags = triangleHitFrontFace ? LIGHT_PATH_NODE_FLAG_HIT_FRONT_FACE : 0;
			lightNodeFlags |= (rayState.getStateFlags() & TRANSMISSION_TYPE_DISPERSED) != 0 ? LIGHT_PATH_NODE_FLAG_TERMINATE_SECONDARY_WAVELENGTHS : 0;
			
            calculateCommonSurfaceParams(rayState, instId, primIndex, bary, woOS, triangleHitFrontFace, surfaceDef, precalculatedSurfaceData, samplingProbabilities);
			bool deltaDistr = isDeltaDistribution(precalculatedSurfaceData.a2, surfaceDef);
			if(deltaDistr)
			{
                lightNodeFlags |= LIGHT_PATH_NODE_FLAG_IS_DELTA_DISTRIBUTION;

            }
			
            float3x3 transformNormal = (float3x3)q.CandidateWorldToObject3x4();
            transformNormal = transpose(transformNormal);
			
            float3 normalWS = normalize(mul(transformNormal, surfaceDef.geometryNormal));
            float3 posWS = q.WorldRayOrigin() + q.WorldRayDirection() * q.CommittedRayT();
			
			//TODO: store some of the ray state (dispersion,volumes(?))
			float toAreaDensityForward = solidAngleToAreaDensityMultiplier(posWS - q.WorldRayOrigin(), normalWS);
			
			{
				SpectralSamples abs = rayState.getAbsorption();
				if(!abs.allSamplesEqual(0))
				{
					radiance = radiance * calculateTransmittance(q.CommittedRayT(), abs);
				}
			}


			nodes[currentNodeIndex].instanceIndex = instId;
			nodes[currentNodeIndex].primitiveIndex = primIndex;
			nodes[currentNodeIndex].barycentrics = bary;
			nodes[currentNodeIndex].normalWS = normalWS;
			nodes[currentNodeIndex].radiance = radiance.toFloat4();
			nodes[currentNodeIndex].positionWS = posWS;
			nodes[currentNodeIndex].pdfForwardMIS = deltaDistr ? -1.f : pdfForward * toAreaDensityForward;
			nodes[currentNodeIndex].iorPrevious = rayState.getPreviousIOR();
			nodes[currentNodeIndex].iorCurrent = rayState.getCurrentIOR();
			nodes[currentNodeIndex].flags = lightNodeFlags;
			
			bool isDiffuseBounce;
			bool sampledDeltaDir;
			float3 wiOS = getSampleDirectionOS(surfaceDef, precalculatedSurfaceData, randomSamples0.x, randomSamples0.y, randomSamples0.zw, samplingProbabilities, isDiffuseBounce, sampledDeltaDir);
            if (isZero(wiOS))
            {
                break;
            }

            SpectralSamples w;
            float pdfBackward;
            evaluateSurfaceAndPDFs(surfaceDef, precalculatedSurfaceData, samplingProbabilities, rayState, woOS, wiOS, triangleHitFrontFace, true, sampledDeltaDir, w, pdfForward, pdfBackward);

			if(pdfBackward == 0)
			{
				break;
			}

			nodes[previousNodeIndex].pdfBackwardMIS = sampledDeltaDir ? -1.f : pdfBackward * solidAngleToAreaDensityMultiplier(q.WorldRayOrigin() - posWS, nodes[previousNodeIndex].normalWS.xyz); //TODO: special case for ENV light
			
			//store previous vertex
			{
				uint vOffset, vCount;
				reserveLightPathNodeSpace(1, vOffset, vCount);
				if(vCount == 0) break;

				storeLightPathVertex(vOffset, compressLightPathNode(nodes[previousNodeIndex]));
				lastVertexOffset = vOffset;
				++lightNodeCount;
			}

			nodes[currentNodeIndex].nextIndex = lastVertexOffset;

			//integrating in path space: G * toAreaDensity mostly cancel and we are left with just dot(normalFrom, toNext), which is included in material sample. So just divide with solid angle pdf
			radiance = radiance * w * safeDiv(1.f, pdfForward);
			
            

			if(radiance.allSamplesEqual(0))
			{
				break;
			}

			rayDir = normalize(mul(transformNormal, wiOS));
			rayOrigin = posWS + getRaySpawnOffsetUsingNormal(normalWS, rayDir);
        }
		else 
		{
		    break;
		}
	}
	
	if(lightNodeCount > 0)
	{
		//store last node
		{
			uint currentNodeIndex = (lightNodeCount-1) & 0x1;
			uint vOffset, vCount;
			reserveLightPathNodeSpace(1, vOffset, vCount);
			if(vCount != 0)
			{
				nodes[currentNodeIndex].nextIndex = lastVertexOffset;
				storeLightPathVertex(vOffset, compressLightPathNode(nodes[currentNodeIndex]));
				lastVertexOffset = vOffset;
			} 
			else
			{
				--lightNodeCount;
			}
		}

		LightPathHeader header;
		header.offsetAndCount = uint2(lastVertexOffset, lightNodeCount);
		header.sampledWavelength = g_spectralMainSampleWavelength;
		storeLightPathHeader(headerOffset, header);
	
	}
	

}

#endif

#ifdef SORT_LIGHT_VERTICES_STAGE
StructuredBuffer<LightPathNodePacked> g_lightPathVerticesUnsorted : register(t5, space3);

[numthreads(64, 1, 1)]
void sortLightVertices( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
	uint headerCount = getLightPathsCount();
	if(dispatchThreadId.x >= headerCount) return;

	LightPathHeader header = getLightPathHeader(dispatchThreadId.x);
	uint vCount = header.offsetAndCount.y;
	if(vCount == 0) return;

	uint vOffset;
	reserveLightPathNodeSpaceForSorting(vCount, vOffset);
	uint nextIndex = header.offsetAndCount.x;

	for(uint i = 0; i < vCount; ++i)
	{
		LightPathNodePacked node = g_lightPathVerticesUnsorted[nextIndex];
		uint storeIndex = vOffset + vCount - i - 1 ;
		storeLightPathVertex(storeIndex, node);		
		nextIndex = getNextIndexFromPackedNode(node);
	}
	

	//store modified header
	header.offsetAndCount.x = vOffset;
	storeLightPathHeader(dispatchThreadId.x, header);

}
#endif

#ifdef CAMERA_RAYS_STAGE



groupshared ExtractedLightPathNodeData g_localNodes[MAX_LIGHT_PATH_VERTICES_HARD_LIMIT];
groupshared LightPathHeader g_lightPathHeader;

SpectralSamples ToSpectralSamples(float3 color)
{
	SpectralSamples s;
	s.setFromRGBUnbounded(color);
	return s;
}



uint2 calculateSourceTextureTexelCoordinates(uint2 groupThreadId, uint2 groupIndex)
{
	const uint WORKGROUPS_IN_SWIZZLE = 8;
	
	uint2 blockIndex = (groupIndex / WORKGROUPS_IN_SWIZZLE);
	uint2 workGroupsInSwizzle = min(uint2(WORKGROUPS_IN_SWIZZLE, WORKGROUPS_IN_SWIZZLE), g_cameraRayWorkGroupCount - blockIndex * WORKGROUPS_IN_SWIZZLE);
	uint2 blockOffset = blockIndex * THREAD_GROUP_DIM_SIZE_CAM_RAY * WORKGROUPS_IN_SWIZZLE;	

	//offset workgroup
	uint2 blockGroupIndex = groupIndex - blockOffset;
	uint flatGroupsCount = workGroupsInSwizzle.x * workGroupsInSwizzle.y;
	uint flatGroupIndex = blockGroupIndex.y * workGroupsInSwizzle.x + blockGroupIndex.x;
	flatGroupIndex = (flatGroupIndex + g_cameraWorkGroupOffset) % flatGroupsCount;

	uint2 inBlockGroupOffset = uint2(flatGroupIndex % workGroupsInSwizzle.x, flatGroupIndex / workGroupsInSwizzle.x);
	uint2 threadOffset = groupThreadId * workGroupsInSwizzle;

	return blockOffset + inBlockGroupOffset + threadOffset;
}

[numthreads(THREAD_GROUP_DIM_SIZE_CAM_RAY, THREAD_GROUP_DIM_SIZE_CAM_RAY, 1)]
void traceCameraRays( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
	uint2 sourceTextureIndices = calculateSourceTextureTexelCoordinates(groupThreadId.xy, groupId.xy);
	uint2 rayIndices = dispatchIndicesToRayIndices(sourceTextureIndices);

	if(rayIndices.x >= g_targetTexDimensions.x || rayIndices.y >= g_targetTexDimensions.y) return;

	RandomSampler rand;
	uint lightPathScrambleOffset = 0;//g_lightPathsPerDim.y * g_lightPathsPerDim.x; //should lightpaths use completely different random values?
    rand.init(0, lightPathScrambleOffset + rayIndices.y * g_targetTexDimensions.x + rayIndices.x); //TODO: init properly


	if(groupIndex == 0)
    {
		uint maxLightPathCount = g_lightPathsPerDim.y * g_lightPathsPerDim.x;
        uint headerCount = min(maxLightPathCount, getLightPathsCount());
		if(headerCount == 0)
		{
			g_lightPathHeader.offsetAndCount = uint2(0, 0);
			g_lightPathHeader.sampledWavelength = calculateSpectralSampleWavelength(rand.getRandom1());
		}
		else
		{
			RandomSampler randTemp;
			randTemp.init(0, groupId.y * g_lightPathsPerDim.x + groupId.x);

			
			uint headerIndex = min(floor(randTemp.getRandom1() * headerCount), headerCount - 1);
			g_lightPathHeader = getLightPathHeader(headerIndex);
		}
        

    }
	
    GroupMemoryBarrierWithGroupSync();
	
	g_spectralMainSampleWavelength = g_lightPathHeader.sampledWavelength;

    if (groupIndex < g_lightPathHeader.offsetAndCount.y)
    {
        LightPathNode node = decompressLightPathNode(getLightPathVertex(g_lightPathHeader.offsetAndCount.x + groupIndex));
        g_localNodes[groupIndex] = getExtractedLightPathNodeData(node);
    }
	
    GroupMemoryBarrierWithGroupSync();
	
	

	float2 uv = (float2)rayIndices * g_targetTexDimensions.zw;
    float3 rayDir = generateRayDirection(uv + g_rayDirUvOffset, rand.getTexelOffset());
	float3 rayOrigin = g_cameraPosition;
	
	SpectralSamples totalLight;
	totalLight.set(0);

	BDPTRayState rayState;
    rayState.setStateFlags(0);
    rayState.numberVolumesEntered = 0;

    CameraVertexContext camVertexContext;
    camVertexContext.throughput.set(1);
    camVertexContext.pdfRatioSum = 0;
    camVertexContext.previousPDFForwardMIS = 0;
	
	float pdfForwardCamera = 1;
	uint camVertexIndex = 0;
	uint pathCount = 0;
	float deferredRISumCamera = 0;

	for(; camVertexIndex < g_maxCameraPathVertices; ++camVertexIndex)
	{
		uint rayFlags = RAY_FLAG_NONE;
		uint InstanceInclusionMask = ~0;

		RayQuery<RAY_FLAG_NONE> q;

		RayDesc ray;
		ray.Origin = rayOrigin;
		ray.Direction = rayDir;
        ray.TMin = DEFAULT_RAY_MIN_T;
		ray.TMax = DEFAULT_RAY_MAX_T;

		q.TraceRayInline(
		    g_accelerationStructure,
		    rayFlags, 
		    InstanceInclusionMask,
		    ray);

		while(q.Proceed());

		float4 randomSamples0 = rand.getRandom4();

		if(q.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
		{
			
            camVertexContext.posWS = q.WorldRayOrigin() + q.WorldRayDirection() * q.CommittedRayT();
            camVertexContext.triangleHitFrontFace = q.CommittedTriangleFrontFace();
            camVertexContext.woOS = normalize(-q.CommittedObjectRayDirection());
            uint instId = q.CommittedInstanceID();
            uint primIndex = q.CommittedPrimitiveIndex();
            float2 bary = q.CommittedTriangleBarycentrics();
			
			bool outputShadingParams = firstBounceMaterialWriteEnabled();
			if(camVertexIndex == 0 && outputShadingParams)
			{
				SurfaceDefinitionRGB surfaceDefRGB;
				fillSurfaceDefRGB(instId, primIndex, bary, surfaceDefRGB);
				float3x3 transformNormal = (float3x3) q.CandidateWorldToObject3x4();
				transformNormal = transpose(transformNormal);


				writeMaterialParamsForFirstBounce(sourceTextureIndices.xy, surfaceDefRGB, transformNormal, q.CommittedRayT(), g_MaterialParamsOutput0, g_MaterialParamsOutput1);
				calculateCommonSurfaceParams(rayState, surfaceDefRGB, camVertexContext.woOS, camVertexContext.triangleHitFrontFace, camVertexContext.surfaceDef, camVertexContext.precalculatedSurfaceData, camVertexContext.samplingProbabilities);
			} 
			else
			{
				calculateCommonSurfaceParams(rayState, instId, primIndex, bary, camVertexContext.woOS, camVertexContext.triangleHitFrontFace, camVertexContext.surfaceDef, camVertexContext.precalculatedSurfaceData, camVertexContext.samplingProbabilities);
			}
			
            
			
            float3x3 transformNormal = (float3x3) q.CandidateWorldToObject3x4();
            transformNormal = transpose(transformNormal);
            camVertexContext.normalWS = normalize(mul(transformNormal, camVertexContext.surfaceDef.geometryNormal));
            
			bool deltaDistr = isDeltaDistribution(camVertexContext.precalculatedSurfaceData.a2, camVertexContext.surfaceDef);
            camVertexContext.currentNodeForwardPDFMIS = pdfForwardCamera < 0 ? 1.f : pdfForwardCamera * solidAngleToAreaDensityMultiplier(camVertexContext.posWS - q.WorldRayOrigin(), camVertexContext.normalWS);
			
			{
				SpectralSamples abs = rayState.getAbsorption();
				if(!abs.allSamplesEqual(0))
				{
                    camVertexContext.throughput = camVertexContext.throughput * calculateTransmittance(q.CommittedRayT(), abs);
                }
			}

            if (!camVertexContext.surfaceDef.emissive.allSamplesEqual(0))
            {
                float misWeight = calculateMISWeightOnCameraPathHittingLight(camVertexIndex, instId, primIndex, bary, camVertexContext);
				if(shouldPathContribute(camVertexIndex + 1, 0))
				{
					totalLight = totalLight + camVertexContext.throughput * camVertexContext.surfaceDef.emissive * misWeight;
					++pathCount;
				}
                
                break; 
            } 
			else if(!deltaDistr)
			//try to connect path to light nodes
			{
                LightVertexContext lightVertexContext;
				lightVertexContext.riSum = 0;
				float deferredRISumLight = 0;
                for (uint lightVertexIndex = 0; lightVertexIndex < g_lightPathHeader.offsetAndCount.y; ++lightVertexIndex)
                {
                    uint lightNodeIndex = lightVertexIndex;
					ExtractedLightPathNodeData nodeData = g_localNodes[lightNodeIndex];
                    LightPathNode lightNode = nodeData.node;
					bool lightNodeIsDelta = (lightNode.flags & LIGHT_PATH_NODE_FLAG_IS_DELTA_DISTRIBUTION) != 0;

					//TODO: no point trying to connect if light is delta
                    if(!lightNodeIsDelta)
					{
						float3x4 toLocalFrame = q.CandidateWorldToObject3x4();
						float3 lightPosOS = mul(toLocalFrame, float4(lightNode.positionWS.xyz, 1)).xyz;
						float3 posOS = mul(toLocalFrame, float4(camVertexContext.posWS, 1)).xyz;
						camVertexContext.wiOS = normalize(lightPosOS - posOS);
					
						SpectralSamples lightConnectionRadiance = calculateLightPathRadiance(camVertexIndex, camVertexContext, nodeData, lightVertexIndex, lightVertexContext, rayState);
                    
						if(shouldPathContribute(camVertexIndex + 1, lightVertexIndex + 1))
						{
							totalLight = totalLight + lightConnectionRadiance;
							++pathCount;
						}
					}
                    
					float pdfRatio = calculatePDFRatio(lightNode.pdfBackwardMIS, lightNode.pdfForwardMIS);
					lightVertexContext.riSum = deferredRISumLight;
					deferredRISumLight *= pdfRatio;
					deferredRISumLight += pdfRatio;
					
					

                    lightVertexContext.prevNodeNormalWS = lightNode.normalWS;
                    lightVertexContext.prevNodePosWS = lightNode.positionWS;
                    lightVertexContext.previousPDFForwardMIS = lightNode.pdfForwardMIS;
					if(lightVertexIndex == 0)
                    {
                        lightVertexContext.originatingNodeFlags = lightNode.flags;
                    }

                }

			}
			bool isDiffuseBounce;
			bool sampledDeltaDir;
            float3 wiOS = getSampleDirectionOS(camVertexContext.surfaceDef, camVertexContext.precalculatedSurfaceData, randomSamples0.x, randomSamples0.y, randomSamples0.zw, camVertexContext.samplingProbabilities, isDiffuseBounce, sampledDeltaDir);

            if (isZero(wiOS))
            {
                break;
            }
                
			if(isDiffuseBounce)
			{
				rayState.addFlags(RAYSTATE_FLAGS_HAS_DIFFUSE_BOUNCE); 
			}

            SpectralSamples w;
            float pdfForward;
            float pdfBackward;
            evaluateSurfaceAndPDFs(camVertexContext.surfaceDef, camVertexContext.precalculatedSurfaceData, camVertexContext.samplingProbabilities, rayState, camVertexContext.woOS, wiOS, camVertexContext.triangleHitFrontFace, false, sampledDeltaDir, w, pdfForward, pdfBackward);

			if(pdfForward == 0)
			{
				break;
			}


			if(camVertexIndex > 0)
            {
                float pdfBackwardPrevNode = sampledDeltaDir ? 1.f : pdfBackward * solidAngleToAreaDensityMultiplier(q.WorldRayOrigin() - camVertexContext.posWS, camVertexContext.prevNodeNormalWS);
                float ratio = calculatePDFRatio(pdfBackwardPrevNode, camVertexContext.previousPDFForwardMIS);
				camVertexContext.pdfRatioSum = deferredRISumCamera;
				
				deferredRISumCamera *= ratio;
				deferredRISumCamera += ratio;
				
            }
			
            camVertexContext.prevNodeNormalWS = camVertexContext.normalWS;
            camVertexContext.prevNodePosWS = camVertexContext.posWS;
            camVertexContext.previousPDFForwardMIS = camVertexContext.currentNodeForwardPDFMIS;
			pdfForwardCamera = sampledDeltaDir ? -1.f : pdfForward;

			float3 wiWS = normalize(mul(transformNormal, wiOS));
            camVertexContext.throughput = camVertexContext.throughput * w * safeDiv(1.f, pdfForward);

			rayDir = wiWS;
            rayOrigin = camVertexContext.posWS + getRaySpawnOffsetUsingNormal(camVertexContext.normalWS, rayDir);
        }
		else 
		{

			bool outputShadingParams = firstBounceMaterialWriteEnabled();
			if (outputShadingParams && camVertexIndex == 0)
			{
				writeEmptyMaterialParamsForFirstBounce(sourceTextureIndices.xy, g_MaterialParamsOutput0, g_MaterialParamsOutput1);
			}

			camVertexContext.currentNodeForwardPDFMIS = pdfForwardCamera;
            float misWeight = calculateMISWeightOnCameraPathMissing(camVertexIndex, camVertexContext, rayOrigin, rayDir);
			
			float4 skyColor = getSkyBoxColor(rayDir, g_envType, g_envTexIndex) * g_envIntensityScale;
			if(shouldPathContribute(camVertexIndex + 1, 0))
			{
#ifdef WHITE_FURNACE_TEST
				totalLight = totalLight + camVertexContext.throughput * ToSpectralSamples(float3(1,1,1)) * misWeight;
#else
				totalLight = totalLight + camVertexContext.throughput * ToSpectralSamples(skyColor.xyz) * misWeight;
#endif
				++pathCount;
			}
			break;
		}
	}

	bool rayDispersed = (rayState.flags & RAYSTATE_FLAGS_SECONDARY_LAMBDAS_TERMINATED) != 0;
    float3 color = totalLight.ToXYZ(rayDispersed);

	g_outputColor[sourceTextureIndices.xy]  = float4(color, 1);
    
	/*
	if(camVertexIndex == 0)
	{
		g_outputColor[sourceTextureIndices.xy] = float4(1.0f, 0.0f, 0.0f,  1.f);
	} else if(camVertexIndex == 1)
	{
		g_outputColor[sourceTextureIndices.xy] = float4(0.0f, 1.0f, 0.0f, 1.f);
	} else if(camVertexIndex < 6)
	{
		g_outputColor[sourceTextureIndices.xy] = float4(0.0f, 0.0f, 1.0f,  10.f);
	} else if(camVertexIndex < 15)
	{
		g_outputColor[sourceTextureIndices.xy] = float4(1.0f, 0.0f, 1.0f,  20.f);
	}
	else 
	{
		g_outputColor[sourceTextureIndices.xy] = float4(1.0f, 1.0f, 1.0f,  1.f);
	}
	return;
	*/
	
	
	/*
	if(payload.numberVolumesEntered == 0 || payload.rayState == RAY_STATE_CANCELLED)
	{
		g_outputColor[sourceTextureIndices.xy] = float4(1.0f, 0.0f, 0.0f,  1.f);
	} else if(payload.numberVolumesEntered < 2)
	{
		g_outputColor[sourceTextureIndices.xy] = float4(0.0f, 1.0f, 0.0f, 1.f);
	} else
	{
		g_outputColor[sourceTextureIndices.xy] = float4(0.0f, 0.0f, 1.0f,  1.f);
	}
	return;
	*/

}

#endif


#if defined(CALCULATE_PURE_LIGHT_PATHS) || defined(ACCUMULATE_PURE_LIGHT_PATHS) || defined(INITIALIZE_PURE_LIGHT_PATH_STRUCTURES)

struct PureLightPathNodeHeader
{
	uint first;
	uint latest;
};

uint calculatePureLightPathHeaderOffset(uint2 texel)
{
	uint offset = texel.y * g_targetTexDimensions.x + texel.x;
	offset *= 2 << 2;
	return offset;
}

uint getPureLightPathNodeSizeInBytes()
{
	return 4 << 2;
}

#define INVALID_PURE_LIGHT_NODE_INDEX (0xFFFFFFFFu)

#ifdef INITIALIZE_PURE_LIGHT_PATH_STRUCTURES
RWByteAddressBuffer g_perTexelPureLightPathHeader : register(u5, space3);

[numthreads(THREAD_GROUP_DIM_SIZE_CAM_RAY, THREAD_GROUP_DIM_SIZE_CAM_RAY, 1)]
void initializePureLightPathResources( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
	if(dispatchThreadId.x >= g_targetTexDimensions.x || dispatchThreadId.y >= g_targetTexDimensions.y) return;
	uint offset = calculatePureLightPathHeaderOffset(dispatchThreadId.xy);
	g_perTexelPureLightPathHeader.Store(offset, uint2(INVALID_PURE_LIGHT_NODE_INDEX, INVALID_PURE_LIGHT_NODE_INDEX));

}
#endif

#ifdef CALCULATE_PURE_LIGHT_PATHS

RWByteAddressBuffer g_perTexelPureLightPathHeader : register(u5, space3);
RWByteAddressBuffer g_pureLightPathNodes : register(u6, space3);

void addContribution(uint2 texel, float3 v)
{
	uint nodeIndex;
	g_counters.InterlockedAdd( COUNTER_LIGHT_VERTICES_PURE_NODE_INDEX << 2 , 1, nodeIndex);

	uint4 val = uint4(asuint(v.x), asuint(v.y), asuint(v.z), INVALID_PURE_LIGHT_NODE_INDEX);
	g_pureLightPathNodes.Store(nodeIndex * getPureLightPathNodeSizeInBytes(), val);
	
	uint offset = calculatePureLightPathHeaderOffset(texel);
	uint offsetToLatest = offset + 4;	

	uint prevVal;
	g_perTexelPureLightPathHeader.InterlockedExchange(offsetToLatest, nodeIndex, prevVal);
	
	if(prevVal == INVALID_PURE_LIGHT_NODE_INDEX)
	{
		g_perTexelPureLightPathHeader.Store(offset, nodeIndex);
	}
	else
	{
		uint previousNodeNextMemberOffset = prevVal * getPureLightPathNodeSizeInBytes() + (3 << 2);
		g_pureLightPathNodes.Store(previousNodeNextMemberOffset, nodeIndex);
	}
	
}

bool getProjectedPositionOnScreen(in LightPathNode node, out uint2 texel)
{
    float4 texelSpace = mul(g_worldToViewTransform, float4(node.positionWS, 1));	
    texelSpace = mul(g_viewToUVTransform, texelSpace);
	texelSpace.xyz /= texelSpace.w;	

	bool isValid = (texelSpace.x >= 0 && texelSpace.x <= 1) && (texelSpace.y >= 0 && texelSpace.y <= 1) && (texelSpace.z >= 0 && texelSpace.z <= 1);
	texel = (uint2)floor(min(texelSpace.xy * g_targetTexDimensions.xy, g_targetTexDimensions.xy - 1));
	return isValid;
}

void calculateRadianceTowardsCamera(in ExtractedLightPathNodeData nodeData, in uint lightNodeIndex, float3 camPos, float3 prevPos, out float4 radianceOut, out float pdfForwardOut, out float pdfBackwardOut)
{
	bool lightNodeIsDelta = (nodeData.node.flags & LIGHT_PATH_NODE_FLAG_IS_DELTA_DISTRIBUTION) != 0;
	if(lightNodeIsDelta)
	{
		radianceOut = 0;
		pdfForwardOut = 0;
		pdfBackwardOut = 0;
		return;
	}

	SpectralSamples s;
	if(!calculateConnectingLightNodeWeightsAndPDFs(nodeData, lightNodeIndex, prevPos, camPos, pdfForwardOut, pdfBackwardOut, s))
	{
		radianceOut = 0;
		pdfForwardOut = 0;
		pdfBackwardOut = 0;
		return;
	}

	radianceOut = s.toFloat4();
}
	
bool checkVisibility(float3 from, float3 to)
{
	uint rayFlags = RAY_FLAG_NONE;
    uint InstanceInclusionMask = ~0;
    RayQuery < RAY_FLAG_NONE > q;

	float3 fromTo = to - from;
	float fromToLen = sqrt(dot(fromTo, fromTo));

	if(fromToLen < 0.0001) return true;

    RayDesc ray;
    ray.Origin = from;
    ray.Direction = fromTo / fromToLen;
    ray.TMin = DEFAULT_RAY_MIN_T;
    ray.TMax = fromToLen;

    q.TraceRayInline(
		    g_accelerationStructure,
		    rayFlags,
		    InstanceInclusionMask,
		    ray);

    while (q.Proceed())
    {
    }

    if (q.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
    {
		return false;
    }
    return true;
}


                    


[numthreads(64, 1, 1)]
void calculatePureLightPaths( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
	uint headerCount = getLightPathsCount();
	if(dispatchThreadId.x >= headerCount) return;

	LightPathHeader header = getLightPathHeader(dispatchThreadId.x);
	uint vCount = header.offsetAndCount.y;
	if(vCount <= 1) return;

	g_spectralMainSampleWavelength = header.sampledWavelength;
	bool rayHasDispersed = false;
	float riSum = 0;
	float deferredRISum = 0;
	float3 prevPos;
	float3 prevNormal;
	float3 prevPDFForwardMIS;
	
	uint originatingLightFlags;
	{
		LightPathNode node = decompressLightPathNode(getLightPathVertex(header.offsetAndCount.x));
		prevNormal = node.normalWS;
		prevPos = node.positionWS;
		prevPDFForwardMIS = node.pdfForwardMIS;
		originatingLightFlags = node.flags;
		float pdfRatio = calculatePDFRatio(node.pdfBackwardMIS, node.pdfForwardMIS);
		deferredRISum *= pdfRatio;
		deferredRISum += pdfRatio;
	}
	
    for(uint i = 1; i < vCount; ++i)
    {
        LightPathNode node = decompressLightPathNode(getLightPathVertex(header.offsetAndCount.x + i));
		ExtractedLightPathNodeData nodeData = getExtractedLightPathNodeData(node);
		uint2 targetTexel;
        if(getProjectedPositionOnScreen(nodeData.node, targetTexel) && shouldPathContribute(0, i + 1))
		{
			float4 radiance;
			float pdfForward;
			float pdfBackward;

			calculateRadianceTowardsCamera(nodeData, i, g_cameraPosition, prevPos, radiance, pdfForward, pdfBackward);
			if(any(radiance) && pdfForward > 0 && pdfBackward > 0)
			{
				if(checkVisibility(nodeData.node.positionWS, g_cameraPosition))
				{
					bool convertAreaDensityBackward = (i == 1) && ((originatingLightFlags & LIGHT_PATH_NODE_FLAG_ENV_LIGHT) != 0);
					float pdfBackwardPrevNode = pdfBackward * (convertAreaDensityBackward ? solidAngleToAreaDensityMultiplier(prevPos - node.positionWS, prevNormal) : 1);
					float ratioPrev = calculatePDFRatio(pdfBackwardPrevNode, prevPDFForwardMIS);
					float riSumCurrent = ratioPrev;

					float ratioCurrent = calculatePDFRatio(1, nodeData.node.pdfForwardMIS);
					riSumCurrent = ratioCurrent * riSumCurrent + ratioCurrent;

					float misWeight = 1.f / (1 + riSum + riSumCurrent);
					float4 contrib = nodeData.node.radiance * (radiance / pdfForward) * misWeight; 
					
					SpectralSamples s;
					s.fromFloat4(contrib);
					float3 color = s.ToXYZ(rayHasDispersed);
					addContribution(targetTexel, color);
				}
			}
		}
		float pdfRatio = calculatePDFRatio(nodeData.node.pdfBackwardMIS, nodeData.node.pdfForwardMIS);
		riSum = deferredRISum;
		deferredRISum *= pdfRatio;
		deferredRISum += pdfRatio;
		prevNormal = nodeData.node.normalWS;
		prevPos = nodeData.node.positionWS;
		prevPDFForwardMIS = nodeData.node.pdfForwardMIS;
    }


}
#endif



#ifdef ACCUMULATE_PURE_LIGHT_PATHS

ByteAddressBuffer g_perTexelPureLightPathHeader : register(t5, space3);
ByteAddressBuffer g_pureLightPathNodes : register(t6, space3);
RWTexture2D<float4> g_outputColor : register(u7, space3);

[numthreads(THREAD_GROUP_DIM_SIZE_CAM_RAY, THREAD_GROUP_DIM_SIZE_CAM_RAY, 1)]
void accumulatePureLightPaths( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
	if(dispatchThreadId.x >= g_targetTexDimensions.x || dispatchThreadId.y >= g_targetTexDimensions.y) return;
	
	uint offset = calculatePureLightPathHeaderOffset(dispatchThreadId.xy);
	
	uint next = g_perTexelPureLightPathHeader.Load(offset);
	float3 accumulatedLightPathRadiance = 0;
	
	while(next != INVALID_PURE_LIGHT_NODE_INDEX)
	{
		uint4 node = g_pureLightPathNodes.Load4(next * getPureLightPathNodeSizeInBytes());
		accumulatedLightPathRadiance += asfloat(node.xyz);
		next = node.w;
	}

	g_outputColor[dispatchThreadId.xy] += float4(accumulatedLightPathRadiance, 0);
}
#endif


