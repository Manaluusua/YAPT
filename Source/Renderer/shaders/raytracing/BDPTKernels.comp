groupshared ExtractedLightPathNodeData g_localNodes[MAX_LIGHT_PATH_VERTICES_HARD_LIMIT];
groupshared LightPathHeader g_lightPathHeader;

SpectralSamples ToSpectralSamples(float3 color)
{
	SpectralSamples s;
	s.setFromRGBUnbounded(color);
	return s;
}

bool calculateConnectingLightNodeWeightsAndPDFs(LightPathNode lightNode, uint lightNodeIndex, float3 prevVertexPos, float3 nextVertexPos, in float2 materialLayerRands, out float pdfForwardOut, out float pdfBackwardOut, SpectralSamples weightOut)
{
    if (lightNodeIndex == 0)
    {
        pdfForwardOut = 1;
        pdfBackwardOut = 1;
		
        weightOut.fromFloat4(lightNode.radiance);
    }
    else
    {
        float3x4 toLocalFrame = g_localNodes[lightNodeIndex].worldToObjSpace;
        float3 lightPosOS = mul(toLocalFrame, float4(lightNode.positionWS.xyz, 1)).xyz;
        float3 prevLightPosOS = mul(toLocalFrame, float4(prevVertexPos, 1)).xyz;
        float3 camNodePosOS = mul(toLocalFrame, float4(nextVertexPos, 1)).xyz;
        float3 wiOS = normalize(camNodePosOS - lightPosOS);
        float3 woOSLightConnection = prevLightPosOS - lightPosOS;
        uint lightNodeFlags = asuint(lightNode.flags);
        bool triangleHitFrontFace = (lightNodeFlags & LIGHT_PATH_NODE_FLAG_HIT_FRONT_FACE) != 0;
                            
        SurfaceDefinitionRGB surfaceDefRGB = g_localNodes[lightNodeIndex].surfaceDefRGB;
	    
        SurfaceDefinition surfaceDef = convertSurfaceDefinitionFromRGB(surfaceDefRGB);
        PrecalculatedSurfaceData precalculatedSurfaceData;
        float samplingProbabilities[LAYER_COUNT];
		
		//for now just initialize with node data. maybe needs a better way (update during light node traversal?)
        BDPTRayState rayState;
        rayState.ior[0] = lightNode.iorPrevious;
        rayState.ior[1] = lightNode.iorCurrent;
        rayState.numberVolumesEntered = 2;
        rayState.setStateFlags(0);

        getPrecalculatedSurfaceData(surfaceDef, rayState.getCurrentIOR(), rayState.getPreviousIOR(), woOSLightConnection, triangleHitFrontFace, precalculatedSurfaceData);
        calculateNormalizedMaterialLayerSamplingProbabilities(surfaceDef, precalculatedSurfaceData, samplingProbabilities);
        evaluateSurfaceAndPDFs(surfaceDef, precalculatedSurfaceData, samplingProbabilities, rayState, woOSLightConnection, wiOS, triangleHitFrontFace, true, weightOut, pdfForwardOut, pdfBackwardOut);
					
        if (pdfForwardOut == 0 || pdfBackwardOut == 0 || weightOut.allSamplesEqual(0))
        {
            return false;
        }
						
        weightOut = weightOut / pdfForwardOut;
    }
	
    return true;
}

struct CameraVertexContext
{
    SurfaceDefinition surfaceDef;
    PrecalculatedSurfaceData precalculatedSurfaceData;
    SpectralSamples throughput;
	float samplingProbabilities[LAYER_COUNT];
    float3 posWS;
    float pdfRatioSum;
    float3 normalWS;
    float3 woOS;
    float3 wiOS;
	
    float3 prevNodePosWS;
    float previousPDFForwardMIS;
    float3 prevNodeNormalWS;
    float currentNodeForwardPDFMIS;
    bool triangleHitFrontFace;
};

struct LightVertexContext
{
    float3 prevNodePosWS;
    float previousPDFForwardMIS;
    float3 prevNodeNormalWS;
    uint originatingNodeFlags;
};

float calculateMISWeight( uint cameraVertexIndex, in CameraVertexContext camVertex,
uint lightVertexIndex, in LightVertexContext lightVertex, in LightPathNode lightNode,
float pdfBackwardLastCameraNode, float pdfForwardLastCameraNode, float pdfBackwardLastLightNode, float pdfForwardLastLightNode)
{
    float riSumCam = camVertex.pdfRatioSum;
	//TODO: the actual first node would be the origina of the ray from camera but its not considered (and can never be hit by path from light). Revisit if its correct to just ignore it here
    if (cameraVertexIndex > 1)
    {
        float pdfBackwardPrevNodeCam = pdfBackwardLastCameraNode * areaDensityMultiplier(camVertex.prevNodePosWS - camVertex.posWS, camVertex.prevNodeNormalWS);
        float ratioPrevCam = pdfBackwardPrevNodeCam / camVertex.previousPDFForwardMIS;
        riSumCam = ratioPrevCam * riSumCam + ratioPrevCam;
    }
    if (cameraVertexIndex > 0)
    {
        float ratioLastCamNode = (pdfForwardLastLightNode * areaDensityMultiplier(camVertex.posWS - lightNode.positionWS.xyz, camVertex.normalWS)) / camVertex.currentNodeForwardPDFMIS;
        riSumCam = ratioLastCamNode * riSumCam + ratioLastCamNode;
    }

	
    float riSumLight = lightNode.riSum;
    if (lightVertexIndex == 0)
    {
        bool isEnvLight = (lightNode.flags & LIGHT_PATH_NODE_FLAG_ENV_LIGHT) != 0;
        float lightPickPDF;
        float lightPosPDF;
        float lightDirPDF;
		
        float3 camToLight = lightNode.positionWS.xyz - camVertex.posWS;
        float camToLightLength = length(camToLight);
        float3 lightToCam = camToLight / camToLightLength;
		
        float misWeightToLight;
        if (isEnvLight)
        {
            pdfForSamplingEnv(g_sampleEnvLightProbabilityWeight, lightToCam, lightPickPDF, lightPosPDF, lightDirPDF);
            misWeightToLight = pdfForwardLastCameraNode;
        }
        else
        {
            pdfForSamplingLightNode(lightNode, lightToCam, g_sampleEnvLightProbabilityWeight, lightPickPDF, lightPosPDF, lightDirPDF);
            misWeightToLight = pdfForwardLastCameraNode * areaDensityMultiplier(camToLight, lightNode.normalWS);
        }
		
        riSumLight = pdfForwardLastCameraNode / (lightPickPDF * lightPosPDF);
		
    } else
    {
        float pdfBackwardPrevNodeLight = pdfBackwardLastLightNode;
        if (lightVertexIndex == 1)
        {
            bool isEnvLight = (lightVertex.originatingNodeFlags & LIGHT_PATH_NODE_FLAG_ENV_LIGHT) != 0;
            if(!isEnvLight)
            {
                pdfBackwardPrevNodeLight *= areaDensityMultiplier(lightVertex.prevNodePosWS - lightNode.positionWS, lightVertex.prevNodeNormalWS);
            }
        }
		
         
        float ratioPrevLightNode = pdfBackwardPrevNodeLight / lightVertex.previousPDFForwardMIS;
        riSumLight = ratioPrevLightNode * riSumLight + ratioPrevLightNode;

		float ratioLastLightNode = (pdfForwardLastCameraNode * areaDensityMultiplier(lightNode.positionWS.xyz - camVertex.posWS, lightNode.normalWS)) / lightNode.pdfForwardMIS;
		riSumLight = ratioLastLightNode * riSumLight + ratioLastLightNode;
    }
	
    float misWeight = 1.f / (1 + riSumCam + riSumLight);
	
    return misWeight;
}

float calculateMISWeightOnCameraPathHittingLight(uint cameraVertexIndex, uint instanceIndex, uint primitiveIndex, float2 bary, CameraVertexContext camVertexContext)
{
	//if we hit directly to light from camera, this path can only be done this way and MIS is 1
	if (cameraVertexIndex == 0)
	{
		return 1.f;
	}

    float lightPickPDF;
    float lightPosPDF;
    float lightDirPDF;
	
    float3 towardsPreviousCameraNode = camVertexContext.prevNodePosWS - camVertexContext.posWS;
	float3 towardsPreviousCameraNodeDir = normalize(towardsPreviousCameraNode);
    pdfForSamplingLight(instanceIndex, primitiveIndex, bary, camVertexContext.normalWS, towardsPreviousCameraNodeDir, g_sampleEnvLightProbabilityWeight, lightPickPDF, lightPosPDF, lightDirPDF);
	
    float riSumCam = camVertexContext.pdfRatioSum;
    float ratioAtLight = (lightPickPDF * lightPosPDF) / camVertexContext.currentNodeForwardPDFMIS;
    float ratioBeforeLight = (lightDirPDF * areaDensityMultiplier(towardsPreviousCameraNode, camVertexContext.prevNodeNormalWS)) / camVertexContext.previousPDFForwardMIS;

    riSumCam = ratioBeforeLight * riSumCam + ratioBeforeLight;
    riSumCam = ratioAtLight * riSumCam + ratioAtLight;

    float misWeight = 1.f / (1 + riSumCam);
    return misWeight;
}

float calculateMISWeightOnCameraPathMissing(uint cameraVertexIndex, CameraVertexContext context, float3 rayOrigin, float3 rayDir)
{
	//if we hit directly to light from camera, this path can only be done this way and MIS is 1
    if (cameraVertexIndex == 0)
    {
        return 1.f;
    }

    float lightPickPDF;
	float lightPosPDF;
	float lightDirPDF;

	pdfForSamplingEnv(g_sampleEnvLightProbabilityWeight, -rayDir, lightPickPDF, lightPosPDF, lightDirPDF);

	float riSumCam = context.pdfRatioSum;
    float ratioAtLight = (lightPickPDF * lightPosPDF) / context.currentNodeForwardPDFMIS;
    float ratioBeforeLight = lightDirPDF / context.previousPDFForwardMIS; //this hits a surface. Should it have areaDensityMultiplier with distance being world bounds or smth?

    riSumCam = ratioBeforeLight * riSumCam + ratioBeforeLight;
    riSumCam = ratioAtLight * riSumCam + ratioAtLight;

	float misWeight = 1.f / (1 + riSumCam);
    return misWeight;
	
}


SpectralSamples calculateLightPathRadiance(uint cameraVertexIndex, in CameraVertexContext camVertex,
uint lightVertexIndex, in LightVertexContext lightVertex, uint lightPathSampleIndex,
in BDPTRayState rayState)
{
    SpectralSamples retVal;
    retVal.set(0);
	
    uint lightNodeIndex = lightVertexIndex;
    LightPathNode lightNode = g_localNodes[lightNodeIndex].node;
                    
    SpectralSamples weightLastCameraNode;
    float pdfForwardLastCameraNode;
    float pdfBackwardLastCameraNode;
	//evaluate weight PDFs for connecting camera node
	{
						
        float pdfForward;
        float pdfBackward;
        evaluateSurfaceAndPDFs(camVertex.surfaceDef, camVertex.precalculatedSurfaceData, camVertex.samplingProbabilities, rayState, camVertex.woOS, camVertex.wiOS, camVertex.triangleHitFrontFace, false, weightLastCameraNode, pdfForward, pdfBackward);
					
        if (pdfForward == 0 || pdfBackward == 0 || weightLastCameraNode.allSamplesEqual(0) )
        {
            return retVal;
        }
						
        weightLastCameraNode = weightLastCameraNode / pdfForward;

        pdfForwardLastCameraNode = pdfForward;
        pdfBackwardLastCameraNode = pdfBackward;
    }
					
    SpectralSamples weightLastLightNode = (SpectralSamples)0;
    float pdfForwardLastLightNode;
    float pdfBackwardLastLightNode;
	//evaluate weight PDFs for connecting light node
	{
        float4 randSamplesLightConn = getRandomSampleFloat4(lightPathSampleIndex + lightNodeIndex, 0); //TODO: better way to calculate sample indices
        bool connectionValid = calculateConnectingLightNodeWeightsAndPDFs(lightNode, lightNodeIndex, lightVertex.prevNodePosWS, camVertex.posWS, randSamplesLightConn.xy, pdfForwardLastLightNode, pdfBackwardLastLightNode, weightLastLightNode);
        if (!connectionValid)
        {
            return retVal;
        }

    }


                    
	float3 toLightWS = lightNode.positionWS.xyz - camVertex.posWS;
	float toLightLenSqr = dot(toLightWS, toLightWS);
    float toLightLen = sqrt(toLightLenSqr);
	float3 toLightDir = toLightWS / toLightLen;
	//trace visibility ray to check visibility with node
	{
        const float VISIBILITY_RAY_EPSILON = 0.001f;
        
		
        uint rayFlags = RAY_FLAG_NONE;
        uint InstanceInclusionMask = ~0;
        RayDesc ray;
        ray.Origin = camVertex.posWS + getRaySpawnOffsetUsingNormal(camVertex.normalWS, toLightDir);
        ray.Direction = toLightDir;
        ray.TMin = DEFAULT_RAY_MIN_T;
        ray.TMax = toLightLen + VISIBILITY_RAY_EPSILON;

        RayQuery < RAY_FLAG_NONE > q;
        q.TraceRayInline(
							g_accelerationStructure,
							rayFlags,
							InstanceInclusionMask,
							ray);

        while (q.Proceed());
						
        bool lightNodeVisible = false;
						
        if (q.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
        {
            uint visInstId = q.CommittedInstanceID();
            uint visPrimIndex = q.CommittedPrimitiveIndex();
							
							//if we hit the light node instance and primitive, good enough for now (could check barycentrics to make sure but should be neglible)
            if (visInstId == lightNode.instanceIndex && visPrimIndex == lightNode.primitiveIndex)
            {
                lightNodeVisible = true;
            }

        }
						
        if (!lightNodeVisible)
        {
            return retVal;
        }
    }
					
	//can connect, evaluate connection and accumulate total light
	{
        float misWeight = calculateMISWeight(cameraVertexIndex, camVertex, lightVertexIndex, lightVertex, lightNode, pdfBackwardLastCameraNode, pdfForwardLastCameraNode, pdfBackwardLastLightNode, pdfForwardLastLightNode);

        SpectralSamples radianceFromLight;
        radianceFromLight.fromFloat4(lightNode.radiance);
						
        float geometryTerm = 1.f / toLightLenSqr;
		geometryTerm *= abs(dot(camVertex.normalWS, toLightDir));
		if((lightNode.flags & LIGHT_PATH_NODE_FLAG_ENV_LIGHT) == 0)
		{
			geometryTerm *= abs(dot(lightNode.normalWS, toLightDir));
		}

		SpectralSamples absorptionOnConnection = rayState.getAbsorption();
		if(!absorptionOnConnection.allSamplesEqual(0))
		{
            weightLastCameraNode = weightLastCameraNode * calculateTransmittance(toLightLen, absorptionOnConnection);
        }

		//TODO: weightlastlightnode produces nan/inf. Also radianceFromLight sometimes very high.
        retVal =  weightLastLightNode * weightLastCameraNode * camVertex.throughput * radianceFromLight  * geometryTerm;

        return retVal;
    }
	
}

[numthreads(8, 8, 1)]
void traceCameraRays( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
	if(groupIndex == 0)
    {
		uint maxLightPathCount = g_lightPathsPerDim.y * g_lightPathsPerDim.x;
        uint headerCount = min(maxLightPathCount, getLightPathsCount());
        uint headerIndex = groupId.y * g_lightPathsPerDim.x + groupId.x;
        headerIndex = headerIndex % headerCount;
        g_lightPathHeader = getLightPathHeader(headerIndex);

    }
	
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex < g_lightPathHeader.offsetAndCount.y)
    {
        LightPathNode node = decompressLightPathNode(getLightPathVertex(g_lightPathHeader.offsetAndCount.x + groupIndex));
        g_localNodes[groupIndex] = getExtractedLightPathNodeData(node);
    }
	
    GroupMemoryBarrierWithGroupSync();
	
	g_spectralSampleOffset = 0;

	float2 uv = (float2)dispatchThreadId.xy * g_targetTexDimensions.zw;
    float3 rayDir = generateRayDirection(uv + g_rayDirUvOffset);
	float3 rayOrigin = g_cameraPosition;
	
	SpectralSamples totalLight;
	totalLight.set(0);

	BDPTRayState rayState;
    rayState.setStateFlags(0);
    rayState.numberVolumesEntered = 0;

    CameraVertexContext camVertexContext;
    camVertexContext.throughput.set(1);
    camVertexContext.pdfRatioSum = 0;
    camVertexContext.previousPDFForwardMIS = 0;
	
	float pdfForwardCamera = 1;
	uint camVertexIndex = 0;
	
	uint2 lightPathIndices = floor((dispatchThreadId.xy * g_targetTexDimensions.zw) * g_lightPathsPerDim);
	uint lightPathSampleIndex = lightPathIndices.y * g_lightPathsPerDim.x + lightPathIndices.x;

	for(; camVertexIndex < g_maxCameraPathVertices; ++camVertexIndex)
	{
		uint rayFlags = RAY_FLAG_NONE;
		uint InstanceInclusionMask = ~0;

		RayQuery<RAY_FLAG_NONE> q;

		RayDesc ray;
		ray.Origin = rayOrigin;
		ray.Direction = rayDir;
        ray.TMin = DEFAULT_RAY_MIN_T;
		ray.TMax = DEFAULT_RAY_MAX_T;

		q.TraceRayInline(
		    g_accelerationStructure,
		    rayFlags, 
		    InstanceInclusionMask,
		    ray);

		while(q.Proceed());

		uint sampleIndex = g_currentRandomSampleIndex + getPerTexelSampleOffset(dispatchThreadId.xy) + camVertexIndex;
		float4 randomSamples0 = getRandomSampleFloat4(sampleIndex, 0);

		if(q.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
		{
			
            camVertexContext.posWS = q.WorldRayOrigin() + q.WorldRayDirection() * q.CommittedRayT();
            camVertexContext.triangleHitFrontFace = q.CommittedTriangleFrontFace();
            camVertexContext.woOS = normalize(-q.CommittedObjectRayDirection());
            uint instId = q.CommittedInstanceID();
            uint primIndex = q.CommittedPrimitiveIndex();
            float2 bary = q.CommittedTriangleBarycentrics();
			
			
            calculateCommonSurfaceParams(rayState, instId, primIndex, bary, camVertexContext.woOS, camVertexContext.triangleHitFrontFace, camVertexContext.surfaceDef, camVertexContext.precalculatedSurfaceData, camVertexContext.samplingProbabilities);
			
            float3x3 transformNormal = (float3x3) q.CandidateWorldToObject3x4();
            transformNormal = transpose(transformNormal);
            camVertexContext.normalWS = normalize(mul(transformNormal, camVertexContext.surfaceDef.geometryNormal));
            
			
            camVertexContext.currentNodeForwardPDFMIS = pdfForwardCamera * areaDensityMultiplier(camVertexContext.posWS - q.WorldRayOrigin(), camVertexContext.normalWS);
			
			{
				SpectralSamples abs = rayState.getAbsorption();
				if(!abs.allSamplesEqual(0))
				{
                    camVertexContext.throughput = camVertexContext.throughput * calculateTransmittance(q.CommittedRayT(), abs);
                }
			}

            if (!camVertexContext.surfaceDef.emissive.allSamplesEqual(0))
            {
                float misWeight = calculateMISWeightOnCameraPathHittingLight(camVertexIndex, instId, primIndex, bary, camVertexContext);
                totalLight = totalLight + camVertexContext.throughput * camVertexContext.surfaceDef.emissive * misWeight;
                break; 
            } 
			else
			//try to connect path to light nodes
			{
                LightVertexContext lightVertexContext;
                for (uint lightVertexIndex = 0; lightVertexIndex < g_lightPathHeader.offsetAndCount.y; ++lightVertexIndex)
                {
                    uint lightNodeIndex = lightVertexIndex;
                    LightPathNode lightNode = g_localNodes[lightNodeIndex].node;
                    
                    float3x4 toLocalFrame = q.CandidateWorldToObject3x4();
                    float3 lightPosOS = mul(toLocalFrame, float4(lightNode.positionWS.xyz, 1)).xyz;
                    float3 posOS = mul(toLocalFrame, float4(camVertexContext.posWS, 1)).xyz;
                    camVertexContext.wiOS = normalize(lightPosOS - posOS);
					
                    SpectralSamples lightConnectionRadiance = calculateLightPathRadiance(camVertexIndex, camVertexContext, lightVertexIndex, lightVertexContext, lightPathSampleIndex, rayState);
                    
                    totalLight = totalLight + lightConnectionRadiance;
					
                    lightVertexContext.prevNodeNormalWS = lightNode.normalWS;
                    lightVertexContext.prevNodePosWS = lightNode.positionWS;
                    lightVertexContext.previousPDFForwardMIS = lightNode.pdfForwardMIS;
					if(lightVertexIndex == 0)
                    {
                        lightVertexContext.originatingNodeFlags = lightNode.flags;
                    }

                }
				//TODO
			}

            float3 wiOS = getSampleDirectionOS(camVertexContext.surfaceDef, camVertexContext.precalculatedSurfaceData, randomSamples0.w, randomSamples0.xy, camVertexContext.samplingProbabilities);

            if (isZero(wiOS))
            {
                break;
            }
                
            SpectralSamples w;
            float pdfForward;
            float pdfBackward;
            evaluateSurfaceAndPDFs(camVertexContext.surfaceDef, camVertexContext.precalculatedSurfaceData, camVertexContext.samplingProbabilities, rayState, camVertexContext.woOS, wiOS, camVertexContext.triangleHitFrontFace, false, w, pdfForward, pdfBackward);

			if(pdfForward == 0 || pdfBackward == 0)
			{
				break;
			}


			if(camVertexIndex > 0)
            {
                float pdfBackwardPrevNode = pdfBackward * areaDensityMultiplier(q.WorldRayOrigin() - camVertexContext.posWS, camVertexContext.prevNodeNormalWS);
                float ratio = pdfBackwardPrevNode / camVertexContext.previousPDFForwardMIS;
                camVertexContext.pdfRatioSum *= ratio;
                camVertexContext.pdfRatioSum += ratio;
            }
			
            camVertexContext.prevNodeNormalWS = camVertexContext.normalWS;
            camVertexContext.prevNodePosWS = camVertexContext.posWS;
            camVertexContext.previousPDFForwardMIS = camVertexContext.currentNodeForwardPDFMIS;
			pdfForwardCamera = pdfForward;

            camVertexContext.throughput = camVertexContext.throughput * w / pdfForward;

			rayDir = normalize(mul(transformNormal, wiOS));
            rayOrigin = camVertexContext.posWS + getRaySpawnOffsetUsingNormal(camVertexContext.normalWS, rayDir);
        }
		else 
		{
			camVertexContext.currentNodeForwardPDFMIS = pdfForwardCamera;	
            float misWeight = calculateMISWeightOnCameraPathMissing(camVertexIndex, camVertexContext, rayOrigin, rayDir);
			
			float4 skyColor = getSkyBoxColor(rayDir, g_envType, g_envTexIndex);
#ifdef WHITE_FURNACE_TEST
			totalLight = totalLight + camVertexContext.throughput * ToSpectralSamples(float3(1,1,1)) * misWeight;
#else
            totalLight = totalLight + camVertexContext.throughput * ToSpectralSamples(skyColor.xyz) * misWeight;
#endif
			break;
		}
	}
	
	bool rayDispersed = (rayState.flags & RAYSTATE_FLAGS_SECONDARY_LAMBDAS_TERMINATED) != 0;
    float3 color = totalLight.ToRGB(COLORSPACE_DEFAULT, rayDispersed);

	g_outputColor[dispatchThreadId.xy]  = float4(color, 1.f);
    
