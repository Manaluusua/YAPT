[numthreads(64, 1, 1)]
void traceLightRays( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{

	g_spectralSampleOffset = 0;

	uint sampleIndex = g_currentRandomSampleIndex + dispatchThreadId.y * g_lightPathsPerDim.x + dispatchThreadId.x;

	SpectralSamples radiance;
	float3 lightPos;
	float3 lightDir;
	
	LightPathNode nodes[2] = {(LightPathNode)0, (LightPathNode)0};
	float pdfForward;

	//sample light
	{
		float4 randomSamples0 = getRandomSampleFloat4(sampleIndex, 0);
		float4 randomSamples1 = getRandomSampleFloat4(sampleIndex, 1);

		float lightSamplePDF;
		float lightPosPDF;
		float lightDirPDF;
        sampleLightOrEnv(randomSamples1.w, randomSamples0, 0.5f, radiance, lightPos, lightDir, lightPosPDF, lightDirPDF, lightSamplePDF);

		if (radiance.allSamplesEqual(0.f) || lightPosPDF == 0 || lightDirPDF == 0 || lightSamplePDF == 0)
        return;

		radiance = radiance / (lightPosPDF * lightDirPDF * lightSamplePDF);


		nodes[0].instanceIndex = -1;
		nodes[0].primitiveIndex = -1;
		nodes[0].barycentrics = -1;
		nodes[0].normalWS = lightDir;
		nodes[0].nextIndex = INVALID_LIGHT_NODE_INDEX;
		nodes[0].radiance = radiance.toFloat4();
		nodes[0].positionWS = lightPos;
		nodes[0].pdfForward = lightPosPDF * lightSamplePDF;
		nodes[0].flags = 0;
		pdfForward = lightDirPDF;
    }

    uint lastVertexOffset = INVALID_LIGHT_NODE_INDEX;
    uint lightNodeCount = 1;
    float3 rayDir = lightDir;
    float3 rayOrigin = lightPos;

	BDPTRayState rayState;
    rayState.setStateFlags(0);
    rayState.numberVolumesEntered = 0;


	for(uint i = 1; i < g_maxVerticesPerLightPath; ++i)
	{
		float4 randomSamples0 = getRandomSampleFloat4(sampleIndex + i, 0);

		uint rayFlags = RAY_FLAG_NONE;
		uint InstanceInclusionMask = ~0;

		RayQuery<RAY_FLAG_NONE> q;

		RayDesc ray;
		ray.Origin = rayOrigin;
		ray.Direction = rayDir;
		ray.TMin = DEFAULT_RAY_MIN_T;
		ray.TMax = 1000.0;

		q.TraceRayInline(
		    g_accelerationStructure,
		    rayFlags, 
		    InstanceInclusionMask,
		    ray);

		while(q.Proceed());

		if(q.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
		{
			
			uint currentNodeIndex = i & 0x1;
			uint previousNodeIndex = ((i-1)) & 0x1;

            SurfaceDefinition surfaceDef;
            PrecalculatedSurfaceData precalculatedSurfaceData;
            float samplingProbabilities[LAYER_COUNT];
            bool triangleHitFrontFace = q.CommittedTriangleFrontFace();
            float3 woOS = -q.CommittedObjectRayDirection();
            uint instId = q.CommittedInstanceID();
            uint primIndex = q.CommittedPrimitiveIndex();
            float2 bary = q.CommittedTriangleBarycentrics();

			uint lightNodeFlags = triangleHitFrontFace ? LIGHT_PATH_NODE_FLAG_HIT_FRONT_FACE : 0;
			lightNodeFlags |= (rayState.getStateFlags() & TRANSMISSION_TYPE_DISPERSED) != 0 ? LIGHT_PATH_NODE_FLAG_TERMINATE_SECONDARY_WAVELENGTHS : 0;
			
            calculateCommonSurfaceParams(rayState, instId, primIndex, bary, woOS, triangleHitFrontFace, randomSamples0.xy,
            surfaceDef, precalculatedSurfaceData, samplingProbabilities);
			
            float3x3 transformNormal = (float3x3)q.CandidateWorldToObject3x4();
            transformNormal = transpose(transformNormal);
			
            float3 normalWS = normalize(mul(transformNormal, surfaceDef.geometryNormal));
            float3 posWS = q.WorldRayOrigin() + q.WorldRayDirection() * q.CommittedRayT();
			
			//TODO: store some of the ray state (dispersion,volumes(?))
			float toAreaDensityForward = areaDensityMultiplier(posWS - q.WorldRayOrigin(), normalWS);
			
			{
				SpectralSamples abs = rayState.getAbsorption();
				if(!abs.allSamplesEqual(0))
				{
					radiance = radiance * calculateTransmittance(q.CommittedRayT(), abs);
				}
			}


			nodes[currentNodeIndex].instanceIndex = instId;
			nodes[currentNodeIndex].primitiveIndex = primIndex;
			nodes[currentNodeIndex].barycentrics = bary;
			nodes[currentNodeIndex].normalWS = normalWS;
			nodes[currentNodeIndex].radiance = radiance.toFloat4();
			nodes[currentNodeIndex].positionWS = posWS;
			nodes[currentNodeIndex].pdfForward = pdfForward * toAreaDensityForward;
			nodes[currentNodeIndex].iorPrevious = rayState.getPreviousIOR();
			nodes[currentNodeIndex].iorCurrent = rayState.getCurrentIOR();
			nodes[currentNodeIndex].flags = lightNodeFlags;

			float3 wiOS = getSampleDirectionOS(surfaceDef, precalculatedSurfaceData, randomSamples0.w, randomSamples0.xy, samplingProbabilities);
            if (isZero(wiOS))
            {
                break;
            }

            SpectralSamples w;
            float pdfBackward;
            evaluateSurfaceAndPDFs(surfaceDef, precalculatedSurfaceData, samplingProbabilities, rayState, woOS, wiOS, triangleHitFrontFace, w, pdfForward, pdfBackward);

			if(pdfForward == 0 || pdfBackward == 0)
			{
				break;
			}

			nodes[previousNodeIndex].pdfBackward = pdfBackward * areaDensityMultiplier(q.WorldRayOrigin() - posWS, nodes[previousNodeIndex].normalWS.xyz);
			
			//store previous vertex
			{
				uint vOffset, vCount;
				reserveLightPathNodeSpace(1, vOffset, vCount);
				if(vCount == 0) break;

				storeLightPathVertex(vOffset, compressLightPathNode(nodes[previousNodeIndex]));
				lastVertexOffset = vOffset;
				++lightNodeCount;
			}

			nodes[currentNodeIndex].nextIndex = lastVertexOffset;

            radiance = radiance * w / pdfForward;

			rayDir = mul(transformNormal, wiOS);
			rayOrigin = posWS;
        }
		else 
		{
		    break;
		}
	}
	
	if(lightNodeCount > 0)
	{
		//store last node
		{
			uint currentNodeIndex = (lightNodeCount-1) & 0x1;
			uint vOffset, vCount;
			reserveLightPathNodeSpace(1, vOffset, vCount);
			if(vCount != 0)
			{
				nodes[currentNodeIndex].nextIndex = lastVertexOffset;
				storeLightPathVertex(vOffset, compressLightPathNode(nodes[currentNodeIndex]));
				lastVertexOffset = vOffset;
			} 
			else
			{
				--lightNodeCount;
			}
		}
	}
	if(lightNodeCount > 0)
	{
		LightPathHeader header;
		header.offsetAndCount = uint2(lastVertexOffset, lightNodeCount);
		uint headerOffset = reserveLightPathHeader();
		storeLightPathHeader(headerOffset, header);
	}

}

#endif

#ifdef SORT_LIGHT_VERTICES_STAGE
StructuredBuffer<LightPathNodePacked> g_lightPathVerticesUnsorted : register(t5, space3);

groupshared LightPathNode g_localNodes[MAX_LIGHT_PATH_VERTICES_HARD_LIMIT];

[numthreads(64, 1, 1)]
void sortLightVertices( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
	uint headerCount = getLightPathsCount();
	if(dispatchThreadId.x >= headerCount) return;

	LightPathHeader header = getLightPathHeader(dispatchThreadId.x);
	uint vCount = header.offsetAndCount.y;
	if(vCount == 0) return;
	
	//fetch to local memory
	{	
		//fetch tail		
		LightPathNode lastNode = decompressLightPathNode(g_lightPathVerticesUnsorted[header.offsetAndCount.x]);

		g_localNodes[0] = lastNode;
	
		//copy entries to linearly
		uint nextIndex = lastNode.nextIndex;

		for(uint i = 1; i < vCount; ++i)
		{
			LightPathNode node = decompressLightPathNode(g_lightPathVerticesUnsorted[nextIndex]);
			g_localNodes[i] = lastNode;
			nextIndex = node.nextIndex;
		}
	}

	//sort
	{
		//precalculate MIS weight ratio sums and store sorted path
		float riSum = 0;

		uint vOffset;
		reserveLightPathNodeSpaceForSorting(vCount, vOffset);
		for(uint i = 0 ; i < vCount; ++i)
		{
			LightPathNode node = g_localNodes[vCount - 1 - i];
			node.riSum = riSum;

			storeLightPathVertex(vOffset + i, compressLightPathNode(node));			


			float pdfRatio = node.pdfBackward / node.pdfForward;
			riSum *= pdfRatio;
			riSum += pdfRatio;
		}		

		//store modified header
		header.offsetAndCount.x = vOffset;
		storeLightPathHeader(dispatchThreadId.x, header);

	}

}
#endif



#ifdef CAMERA_RAYS_STAGE



groupshared ExtractedLightPathNodeData g_localNodes[MAX_LIGHT_PATH_VERTICES_HARD_LIMIT];
groupshared LightPathHeader g_lightPathHeader;

SpectralSamples ToSpectralSamples(float3 color)
{
	SpectralSamples s;
	s.setFromRGBUnbounded(color);
	return s;
}

bool calculateConnectingLightNodeWeightsAndPDFs(LightPathNode lightNode, uint lightNodeIndex, float3 prevVertexPos, float3 nextVertexPos, in float2 materialLayerRands, out float pdfForwardOut, out float pdfBackwardOut, SpectralSamples weightOut)
{
    if (lightNodeIndex == 0)
    {
        pdfForwardOut = 1;
        pdfBackwardOut = 1;
        weightOut.fromFloat4(lightNode.radiance);
    }
    else
    {
        float3x4 toLocalFrame = g_localNodes[lightNodeIndex].worldToObjSpace;
        float3 lightPosOS = mul(toLocalFrame, float4(lightNode.positionWS.xyz, 1)).xyz;
        float3 prevLightPosOS = mul(toLocalFrame, float4(prevVertexPos, 1)).xyz;
        float3 camNodePosOS = mul(toLocalFrame, float4(nextVertexPos, 1)).xyz;
        float3 wiOS = normalize(camNodePosOS - lightPosOS);
        float3 woOSLightConnection = prevLightPosOS - lightPosOS;
        uint lightNodeFlags = asuint(lightNode.flags);
        bool triangleHitFrontFace = (lightNodeFlags & LIGHT_PATH_NODE_FLAG_HIT_FRONT_FACE) != 0;
                            
        SurfaceDefinitionRGB surfaceDefRGB = g_localNodes[lightNodeIndex].surfaceDefRGB;
        surfaceDefRGB.coatingLayerNormal = nudgeNormal(-woOSLightConnection, surfaceDefRGB.coatingLayerNormal, surfaceDefRGB);
        surfaceDefRGB.baseLayerNormal = nudgeNormal(-woOSLightConnection, surfaceDefRGB.baseLayerNormal, surfaceDefRGB);
        surfaceDefRGB.geometryNormal = nudgeNormal(-woOSLightConnection, surfaceDefRGB.geometryNormal, surfaceDefRGB);
	    
        SurfaceDefinition surfaceDef = convertSurfaceDefinitionFromRGB(surfaceDefRGB);
        PrecalculatedSurfaceData precalculatedSurfaceData;
        float samplingProbabilities[LAYER_COUNT];
		
		//for now just initialize with node data. maybe needs a better way (update during light node traversal?)
        BDPTRayState rayState;
        rayState.ior[0] = lightNode.iorPrevious;
        rayState.ior[1] = lightNode.iorCurrent;
        rayState.numberVolumesEntered = 2;
        rayState.setStateFlags(0);

        getPrecalculatedSurfaceData(surfaceDef, rayState.getCurrentIOR(), rayState.getPreviousIOR(), woOSLightConnection, triangleHitFrontFace, precalculatedSurfaceData);
        calculateNormalizedMaterialLayerSamplingProbabilities(surfaceDef, precalculatedSurfaceData, materialLayerRands, samplingProbabilities);
        evaluateSurfaceAndPDFs(surfaceDef, precalculatedSurfaceData, samplingProbabilities, rayState, woOSLightConnection, wiOS, triangleHitFrontFace, weightOut, pdfForwardOut, pdfBackwardOut);
					
        if (pdfForwardOut == 0 || pdfBackwardOut == 0 || weightOut.allSamplesEqual(0))
        {
            return false;
        }
						
        weightOut = weightOut / pdfForwardOut;
    }
	
    return true;
}

[numthreads(8, 8, 1)]
void traceCameraRays( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
	if(groupIndex == 0)
    {
        uint headerCount = getLightPathsCount();
        uint headerIndex = groupId.y * g_lightPathsPerDim.x + groupId.x;
        headerIndex = headerIndex % headerCount;
        g_lightPathHeader = getLightPathHeader(headerIndex);

    }
	
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex < g_lightPathHeader.offsetAndCount.y)
    {
        LightPathNode node = decompressLightPathNode(getLightPathVertex(g_lightPathHeader.offsetAndCount.x + groupIndex));
        g_localNodes[groupIndex] = getExtractedLightPathNodeData(node);
    }
	
    GroupMemoryBarrierWithGroupSync();
	
	g_spectralSampleOffset = 0;

	float2 uv = (float2)dispatchThreadId.xy * g_targetTexDimensions.zw;
    float3 rayDir = generateRayDirection(uv + g_rayDirUvOffset);
	float3 rayOrigin = g_cameraPosition;
	
	SpectralSamples throughput;
	SpectralSamples totalLight;
	throughput.set(1);
	totalLight.set(0);

	BDPTRayState rayState;
    rayState.setStateFlags(0);
    rayState.numberVolumesEntered = 0;

    float pdfRatioSum = 0;
	float pdfForwardCamera = 1;
	float pdfForwardMISPreviousCamNode = 0;
	float3 previousNodeNormalWS;
	uint cameraVertexCount = 0;
	uint rayIndex = dispatchThreadId.y * g_targetTexDimensions.x + dispatchThreadId.x;
	
	uint2 lightPathIndices = floor((dispatchThreadId.xy * g_targetTexDimensions.zw) * g_lightPathsPerDim);
	uint lightPathSampleIndex = lightPathIndices.y * g_lightPathsPerDim.x + lightPathIndices.x;

	for(uint camVertexIndex = 0; camVertexIndex < g_maxCameraPathVertices; ++camVertexIndex)
	{
		uint sampleIndex = g_currentRandomSampleIndex + (dispatchThreadId.y * 7) + camVertexIndex * 5 + rayIndex * 11;
		float4 randomSamples0 = getRandomSampleFloat4(sampleIndex, 0);

		uint rayFlags = RAY_FLAG_NONE;
		uint InstanceInclusionMask = ~0;

		RayQuery<RAY_FLAG_NONE> q;

		RayDesc ray;
		ray.Origin = rayOrigin;
		ray.Direction = rayDir;
        ray.TMin = DEFAULT_RAY_MIN_T;
		ray.TMax = 1000.0;

		q.TraceRayInline(
		    g_accelerationStructure,
		    rayFlags, 
		    InstanceInclusionMask,
		    ray);

		while(q.Proceed());

		if(q.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
		{
			
            SurfaceDefinition surfaceDef;
            PrecalculatedSurfaceData precalculatedSurfaceData;
            float samplingProbabilities[LAYER_COUNT];
            bool triangleHitFrontFace = q.CommittedTriangleFrontFace();
            float3 woOS = -q.CommittedObjectRayDirection();
            uint instId = q.CommittedInstanceID();
            uint primIndex = q.CommittedPrimitiveIndex();
            float2 bary = q.CommittedTriangleBarycentrics();
			
			
            calculateCommonSurfaceParams(rayState, instId, primIndex, bary, woOS, triangleHitFrontFace, randomSamples0.xy,
            surfaceDef, precalculatedSurfaceData, samplingProbabilities);
			
            float3x3 transformNormal = (float3x3) q.CandidateWorldToObject3x4();
            transformNormal = transpose(transformNormal);
            float3 normalWS = mul(transformNormal, surfaceDef.geometryNormal);
            float3 posWS = q.WorldRayOrigin() + q.WorldRayDirection() * q.CommittedRayT();
			
            float pdfForwardMISThisNode = pdfForwardCamera * areaDensityMultiplier(posWS - q.WorldRayOrigin(), normalWS);
			
			{
				SpectralSamples abs = rayState.getAbsorption();
				if(!abs.allSamplesEqual(0))
				{
					throughput = throughput * calculateTransmittance(q.CommittedRayT(), abs);
				}
			}

            if (!surfaceDef.emissive.allSamplesEqual(0))
            {
                totalLight = totalLight + throughput * surfaceDef.emissive; //TODO: proper MIS weight
                break; 
            } 
			else
			//try to connect path to light nodes
			{
                float3 prevLightNodePosWS;
                float3 prevLightNodenormalWS;
                for (uint lightVertexIndex = 0; lightVertexIndex < g_lightPathHeader.offsetAndCount.y; ++lightVertexIndex)
                {
                    uint lightNodeIndex = g_lightPathHeader.offsetAndCount.y - lightVertexIndex - 1;
                    LightPathNode lightNode = g_localNodes[lightNodeIndex].node;
                    
					
                    SpectralSamples weightLastCameraNode;
					float pdfForwardLastCameraNode;
                    float pdfBackwardLastCameraNode;
					//evaluate weight PDFs for connecting camera node
					{
						
						float3x4 toLocalFrame = q.CandidateWorldToObject3x4();
						float3 lightPosOS = mul(toLocalFrame, float4(lightNode.positionWS.xyz, 1)).xyz;
						float3 posOS = mul(toLocalFrame, float4(posWS, 1)).xyz;
						float3 wiOS = normalize(lightPosOS - posOS);
                        float pdfForward;
                        float pdfBackward;
						evaluateSurfaceAndPDFs(surfaceDef, precalculatedSurfaceData, samplingProbabilities, rayState, woOS, wiOS, triangleHitFrontFace, weightLastCameraNode, pdfForward, pdfBackward);
					
						if (pdfForward == 0 || pdfBackward == 0 || weightLastCameraNode.allSamplesEqual(0))
                        {
                            prevLightNodePosWS = lightNode.positionWS;
                            prevLightNodenormalWS = lightNode.normalWS;
                            continue;
                        }
						
						weightLastCameraNode = weightLastCameraNode / pdfForward;

						pdfForwardLastCameraNode = pdfForward;
						pdfBackwardLastCameraNode = pdfBackward;
						//TODO: need to calculate pdf backward for previous node and update MIS sum accumulation
                    }
					
                    SpectralSamples weightLastLightNode;
                    float pdfForwardLastLightNode;
                    float pdfBackwardLastLightNode;
					//evaluate weight PDFs for connecting light node
					{
						float4 randSamplesLightConn = getRandomSampleFloat4(lightPathSampleIndex + lightNodeIndex, 0); //TODO: better way to calculate sample indices
                        bool connectionValid = calculateConnectingLightNodeWeightsAndPDFs(lightNode, lightNodeIndex, prevLightNodePosWS, posWS, randSamplesLightConn.xy, pdfForwardLastLightNode, pdfBackwardLastLightNode, weightLastLightNode);
                        prevLightNodePosWS = lightNode.positionWS;
                        if (!connectionValid)
                        {
                            continue;
                        }

                    }
                    
					
					//trace visibility ray to check visibility with node
					{
                        const float VISIBILITY_RAY_EPSILON = 0.001f;
                        float3 toLightWS = lightNode.positionWS.xyz - posWS;
                        float toLightLen = length(toLightWS);
						
                        RayDesc ray;
                        ray.Origin = posWS;
                        ray.Direction = toLightWS / toLightLen;
                        ray.TMin = DEFAULT_RAY_MIN_T;
                        ray.TMax = toLightLen + VISIBILITY_RAY_EPSILON;

                        q.TraceRayInline(
							g_accelerationStructure,
							rayFlags,
							InstanceInclusionMask,
							ray);

                        while (q.Proceed());
						
                        bool lightNodeVisible = false;
						
                        if (q.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
                        {
                            uint visInstId = q.CommittedInstanceID();
                            uint visPrimIndex = q.CommittedPrimitiveIndex();
							
							//if we hit the light node instance and primitive, good enough for now (could check barycentrics to make sure but should be neglible)
                            if (visInstId == lightNode.instanceIndex && visPrimIndex == lightNode.primitiveIndex)
                            {
                                lightNodeVisible = true;
                            }

                        } 
						
						if(!lightNodeVisible)
                        {
                            continue;
                        }
                    }
					
					//can connect, evaluate connection and accumulate total light
					{


						//float pdfForwardLastCameraNode;
						//float pdfBackwardLastCameraNode;


						//float pdfForwardLastLightNode;
						//float pdfBackwardLastLightNode;
						
                        float riSumCam = pdfRatioSum;
						
                        if (camVertexIndex > 1)
                        {
                            float pdfBackwardPrevNodeCam = pdfBackwardLastCameraNode * areaDensityMultiplier(q.WorldRayOrigin() - posWS, previousNodeNormalWS);
                            float ratioPrevCam = pdfBackwardPrevNodeCam / pdfForwardMISPreviousCamNode;
                            riSumCam = ratioPrevCam * riSumCam + ratioPrevCam;
                        } 
						else if(camVertexIndex == 1)
                        {
                            float ratioLastCam = (pdfForwardLastLightNode * areaDensityMultiplier(posWS - lightNode.positionWS.xyz, normalWS)) / pdfForwardMISThisNode;
                            riSumCam = ratioLastCam * riSumCam + ratioLastCam;
                        } 
						else
                        {
                            
                        }
						
						
                        
                        float riSumLight = lightNode.riSum;
                        if (lightVertexIndex > 1)
                        {
							
                        }
                        else if (lightVertexIndex == 1)
                        {
							
                        } 
						else
                        {
							
                        }
						
                        float misWeight = 1.f / (1 + riSumCam + riSumLight);
						

						
                    }

                }
				//TODO
			}

            float3 wiOS = getSampleDirectionOS(surfaceDef, precalculatedSurfaceData, randomSamples0.w, randomSamples0.xy, samplingProbabilities);

            if (isZero(wiOS))
            {
                break;
            }
                
            SpectralSamples w;
            float pdfForward;
            float pdfBackward;
            evaluateSurfaceAndPDFs(surfaceDef, precalculatedSurfaceData, samplingProbabilities, rayState, woOS, wiOS, triangleHitFrontFace, w, pdfForward, pdfBackward);

			if(pdfForward == 0 || pdfBackward == 0)
			{
				break;
			}


			if(camVertexIndex > 0)
            {
                float pdfBackwardPrevNode = pdfBackward * areaDensityMultiplier(q.WorldRayOrigin() - posWS, previousNodeNormalWS);
                float ratio = pdfBackwardPrevNode / pdfForwardMISPreviousCamNode;
                pdfRatioSum *= ratio;
                pdfRatioSum += ratio;
            }
			
            previousNodeNormalWS = normalWS;
            pdfForwardMISPreviousCamNode = pdfForwardMISThisNode;
			pdfForwardCamera = pdfForward;

            throughput = throughput * w / pdfForward;

			rayDir = mul(transformNormal, wiOS);
			rayOrigin = posWS;
        }
		else 
		{
			float4 skyColor = getSkyBoxColor(rayDir, g_envType, g_envTexIndex);
#ifdef WHITE_FURNACE_TEST
			totalLight = totalLight + throughput * ToSpectralSamples(float3(1,1,1));
#else
			totalLight = totalLight + throughput * ToSpectralSamples(skyColor.xyz);
#endif
			++cameraVertexCount;
			break;
		}
	}
	
	bool rayDispersed = (rayState.flags & RAYSTATE_FLAGS_SECONDARY_LAMBDAS_TERMINATED) != 0;
    float3 color = totalLight.ToRGB(COLORSPACE_DEFAULT, rayDispersed);

	g_outputColor[dispatchThreadId.xy]  = float4(color, 1.f);
    
	/*
	if(payload.pathLength == 1)
	{
		g_outputColor[dispatchThreadId.xy] = float4(1.0f, 0.0f, 0.0f,  1.f);
	} else if(payload.pathLength < 3)
	{
		g_outputColor[dispatchThreadId.xy] = float4(0.0f, 1.0f, 0.0f, 1.f);
	} else if(payload.pathLength < 6)
	{
		g_outputColor[dispatchThreadId.xy] = float4(0.0f, 0.0f, 1.0f,  10.f);
	} else if(payload.pathLength < 15)
	{
		g_outputColor[dispatchThreadId.xy] = float4(1.0f, 0.0f, 1.0f,  20.f);
	}
	else 
	{
		g_outputColor[dispatchThreadId.xy] = float4(1.0f, 1.0f, 1.0f,  1.f);
	}
	return;
	*/
	
	
	/*
	if(payload.numberVolumesEntered == 0 || payload.rayState == RAY_STATE_CANCELLED)
	{
		g_outputColor[dispatchThreadId.xy] = float4(1.0f, 0.0f, 0.0f,  1.f);
	} else if(payload.numberVolumesEntered < 2)
	{
		g_outputColor[dispatchThreadId.xy] = float4(0.0f, 1.0f, 0.0f, 1.f);
	} else
