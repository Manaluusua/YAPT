#include "../common/common.hlsl"
#include "../common/commonMath.hlsl"
#include "denoiseFeatures.hlsl"
#include "../common/colorSpaces.hlsl"


//#define DENOISE_CHROMA_SEPARATELY

struct DenoiseParams
{
    float4x4 uvToView;
    float4x4 viewToWorld;
    float4 cameraPosition;
    float4 textureDimensions;
    uint4 modePassIndex;
    float4 bilaterWeightParams;
    uint4 miscParams;
    float4 featureParams; //x: feature variance scale
};



#define DENOISE_MODE_OFF 0
#define DENOISE_MODE_ON 1
#define DENOISE_MODE_MAT_PARAMS_DEBUG 2
#define DENOISE_MODE_VARIANCE_DEBUG 3
#define DENOISE_SHOW_SAMPLE_SOURCES 4
#define DENOISE_MODE_FEATURE_VARIANCE_DEBUG 5

ConstantBuffer<DenoiseParams> g_denoiseParams : register(b0, space0);
Texture2D g_sourceTex : register(t1, space0);
Texture2D<uint4> g_denoiseFeatures0 : register(t2, space0);
Texture2D<uint4> g_denoiseFeatures1 : register(t3, space0);
Texture2D<float> g_varianceTex : register(t4, space0);
Texture2D g_lastSamples : register(t5, space0);
RWTexture2D<float4> g_denoiseColor : register(u6, space0);
RWTexture2D<float> g_denoiseVariance : register(u7, space0);

#define g_denoiseMode (g_denoiseParams.modePassIndex.x)
#define g_denoisePassIndex (g_denoiseParams.modePassIndex.y)
#define g_denoiseTextureSize (g_denoiseParams.textureDimensions.xy)
#define g_denoiseTextureSizeInv (g_denoiseParams.textureDimensions.zw)
#define g_denoiseDepthSigmaScale (g_denoiseParams.bilaterWeightParams.x)
#define g_denoiseNormalSigma (g_denoiseParams.bilaterWeightParams.y)
#define g_denoiseMaterialSigma (g_denoiseParams.bilaterWeightParams.z)
#define g_denoiseColorSigma (g_denoiseParams.bilaterWeightParams.w)
#define g_convert2RGB (g_denoiseParams.miscParams.x)
#define g_denoiseFeatureVarianceScale (g_denoiseParams.featureParams.x)

float4 calculateDebugFeatures(uint2 loc, bool showVariances)
{
    float2 scaledUv = (loc * g_denoiseParams.textureDimensions.zw) * 2.f;
    uint2 readLocation = frac(scaledUv) * g_denoiseParams.textureDimensions.xy;
    
    DenoiseFeatures f = readDenoiseFeatures(readLocation, g_denoiseFeatures0, g_denoiseFeatures1);
    
    if (showVariances)
    {
        //standard deviations, depth relative to the depth itself
        float relDepthStdDev = f.depth > 0.f ? sqrt(f.varDepth) / f.depth : 0.f;
        float v = 0;
        if (scaledUv.x < 1)
        {
            v = scaledUv.y < 1 ? sqrt(f.varAlbedo) : sqrt(getNormalVariance(f));
        }
        else
        {
            v = scaledUv.y < 1 ? relDepthStdDev : sqrt(f.varMaterial);
        }
        return float4(v, v, v, 1.f);
    }

    if(scaledUv.x < 1)
    {
        if (scaledUv.y < 1)
        {
            return float4(f.albedo, 1);
        } 
        else
        {
            return float4(f.normal * 0.5f + 0.5f, 1);
        }
    } 
    else
    {
        if (scaledUv.y < 1)
        {
            return float4(f.roughness, f.metalness, f.transparency, 1.f);
        }
        else
        {
            return float4(f.anisotropy, f.ior, f.depth / (1.f + f.depth), 1.f);
        }
    }
}


float calculatePerceptualLuminance(float3 c)
{
    return dot(c, float3(0.2126, 0.7152, 0.0722));
}

//depth is planar view space depth, so in-focus points reconstruct exactly along the pinhole ray even with a thin lens camera
float3 reconstructWorldPosition(uint2 loc, float depth)
{
    float2 uv = (float2(loc) + 0.5f) * g_denoiseParams.textureDimensions.zw;

    float4 pointOnNearPlane = float4(uv, 0.0f, 1.0f);
    pointOnNearPlane = mul(g_denoiseParams.uvToView, pointOnNearPlane);
    pointOnNearPlane /= pointOnNearPlane.w;

    float3 posVS = pointOnNearPlane.xyz * (depth / max(abs(pointOnNearPlane.z), 1e-8f));
    return mul(g_denoiseParams.viewToWorld, float4(posVS, 1.f)).xyz;
}

float calculatePlaneDistanceWeight(float3 centerPos, DenoiseFeatures center, float3 samplePos, DenoiseFeatures s, FeatureWeightParams params)
{
    if (s.depth <= 0.f)
    {
        return 1.f; //no hits in the sample pixel, albedo and normal (zeros for misses) handle the edge
    }

    float dist;
    float normalLen = length(center.normal);
    if (normalLen > 1e-3f)
    {
        dist = dot(center.normal / normalLen, samplePos - centerPos);
    }
    else
    {
        dist = center.depth - s.depth;
    }
    return calculateVarianceNormalizedWeight(dist * dist, center.depth * params.depthSigmaScale, center.varDepth + s.varDepth, params.varianceScale);
}

float calculateKernelDistanceWeight(float2 deltaFromCenter, float sigma)
{
    return gaussian(deltaFromCenter, sigma);
}

uint floatToUint(float v)
{
    return uint(floor(max(v, 0) + 0.5f));
}

struct AtrousPassOutput
{
    float4 color;
    float variance;
};

AtrousPassOutput denoiseAtrous(int2 texCoord, uint passNumber)
{
    
    const float precalculatedGaussian3tap[3] = { 3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0 };

    const float precalculatedGaussian3x3tap[3][3] =
    {
        { 1.0 / 16, 1.0 / 8, 1.0 / 16 },
        { 1.0 / 8, 1.0 / 4, 1.0 / 8 },
        { 1.0 / 16, 1.0 / 8, 1.0 / 16 }
    };

    const float EPS_MIN = 1e-6;
    
    float filteredVarSum = 0.0;
    float filteredVarWeight = 0.0;

    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            int2 sampleLoc = int2(texCoord) + int2(x, y);
            
            if (sampleLoc.x < 0 || sampleLoc.x > (g_denoiseTextureSize.x - 1) || sampleLoc.y < 0 || sampleLoc.y > (g_denoiseTextureSize.y - 1))
                continue;
            
            float v = g_varianceTex.Load(uint3(sampleLoc.x, sampleLoc.y, 0));
            float w = precalculatedGaussian3x3tap[x + 1][y + 1];
            filteredVarSum    += v * w;
            filteredVarWeight += w;
        }
    }
    float centerVarFiltered = filteredVarSum / max(filteredVarWeight, EPS_MIN);
    float centerStdDev = sqrt(max(centerVarFiltered, EPS_MIN));

    DenoiseFeatures centerFeatures = readDenoiseFeatures(texCoord.xy, g_denoiseFeatures0, g_denoiseFeatures1);
    float4 centercolor = g_sourceTex.Load(uint3(texCoord.xy, 0));
    if (centerFeatures.depth <= 0.f)
    {
        AtrousPassOutput output;
        output.color = centercolor;
        output.variance = 0;
        return output;
    }
        
    float3 centerPos = reconstructWorldPosition(texCoord.xy, centerFeatures.depth);

    FeatureWeightParams featureWeightParams;
    featureWeightParams.normalSigma = g_denoiseNormalSigma;
    featureWeightParams.materialSigma = g_denoiseMaterialSigma;
    featureWeightParams.depthSigmaScale = g_denoiseDepthSigmaScale;
    featureWeightParams.varianceScale = g_denoiseFeatureVarianceScale;
    
    float4 sumColor = float4(0, 0, 0, 0);
    float  sumVarSq = 0.0;
    float  sumWeight = 0.0;

#ifdef DENOISE_CHROMA_SEPARATELY
    float4 sumChroma = float4(0, 0, 0, 0);
    float  sumChromaWeight = 0.0;
#endif

    int stepSize = 1u << passNumber;

    for (int y = -2; y <= 2; y++)
    {
        for (int x = -2; x <= 2; x++)
        {
            int2 sampleLoc = int2(texCoord) + int2(x, y) * stepSize;

            if (sampleLoc.x < 0 || sampleLoc.x > (g_denoiseTextureSize.x - 1) || sampleLoc.y < 0 || sampleLoc.y > (g_denoiseTextureSize.y - 1))
                continue;
            
            float kernelWeight = precalculatedGaussian3tap[abs(x)] * precalculatedGaussian3tap[abs(y)];
            DenoiseFeatures sampleFeatures = readDenoiseFeatures(sampleLoc, g_denoiseFeatures0, g_denoiseFeatures1);

            float4 sampleColor = g_sourceTex.Load(uint3(sampleLoc.x, sampleLoc.y, 0));
            float sampleVar = g_varianceTex.Load(uint3(sampleLoc.x, sampleLoc.y, 0));

            float3 samplePos = reconstructWorldPosition(sampleLoc, sampleFeatures.depth);
            float wDepth = calculatePlaneDistanceWeight(centerPos, centerFeatures, samplePos, sampleFeatures, featureWeightParams);
            float wMat = calculateFeatureWeight(centerFeatures, sampleFeatures, featureWeightParams);

            float colorDiff = abs(sampleColor.y - centercolor.y);
            float wColor = exp(-colorDiff / (g_denoiseColorSigma * centerStdDev + EPS_MIN));

            float w = kernelWeight * wDepth * wMat * wColor;

            sumColor  += sampleColor * w;
            sumVarSq  += w * w * sampleVar;
            sumWeight += w;

#ifdef DENOISE_CHROMA_SEPARATELY
            float wChroma = kernelWeight * wDepth * wMat;
            sumChroma       += sampleColor * wChroma;
            sumChromaWeight += wChroma;
#endif
        }
    }

    float invWeight = 1.0 / max(sumWeight, EPS_MIN);

    AtrousPassOutput output;
    
    output.color = sumColor * invWeight;
    output.variance = sumVarSq * invWeight * invWeight;

#ifdef DENOISE_CHROMA_SEPARATELY

    {
        float4 chromaFiltered = sumChroma / max(sumChromaWeight, EPS_MIN);
        if (chromaFiltered.y > EPS_MIN && output.color.y > 0.f)
        {
            output.color.xyz = chromaFiltered.xyz * (output.color.y / chromaFiltered.y);
        }
    }
#endif

    return output;
}

float3 gamutClamp(float3 col)
{

    float lum = calculatePerceptualLuminance(col);
    float m = min(min(col.x, col.y), col.z);
    if (m < 0.f)
    {
        col.xyz = lerp(lum.xxx, col.xyz, safeDiv(lum, lum - m));
    }
    return col;
}


[numthreads(8, 8, 1)]
void main( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
    if (dispatchThreadId.x < g_denoiseTextureSize.x && dispatchThreadId.y < g_denoiseTextureSize.y)
	{
        float4 col = 0;
        bool allowConversion = true;
        if (g_denoiseMode == DENOISE_MODE_ON)
        {
            AtrousPassOutput o = denoiseAtrous(dispatchThreadId.xy, g_denoisePassIndex);
            col = o.color;
            g_denoiseVariance[dispatchThreadId.xy] = o.variance;

        }
        else if (g_denoiseMode == DENOISE_MODE_OFF)
        {
            col = g_sourceTex.Load(uint3(dispatchThreadId.xy, 0));
        }
        else if (g_denoiseMode == DENOISE_MODE_MAT_PARAMS_DEBUG)
        {
            col = calculateDebugFeatures(dispatchThreadId.xy, false);
            allowConversion = false;
        }
        else if (g_denoiseMode == DENOISE_MODE_FEATURE_VARIANCE_DEBUG)
        {
            col = calculateDebugFeatures(dispatchThreadId.xy, true);
            allowConversion = false;
        }
        else if (g_denoiseMode == DENOISE_MODE_VARIANCE_DEBUG)
        {
            float var = g_varianceTex.Load(uint3(dispatchThreadId.xy, 0));
            col = var;
            allowConversion = false;
        }
        else if (g_denoiseMode == DENOISE_SHOW_SAMPLE_SOURCES)
        {
            col = g_lastSamples.Load(uint3(dispatchThreadId.xy, 0)); //TODO
        }
        
        if (g_convert2RGB != 0 && allowConversion)
        {
            col.xyz = mul(c_srgbXYZToRGB, col.xyz);
            col.xyz = gamutClamp(col.xyz);

        }
        
        g_denoiseColor[dispatchThreadId.xy] = col;
        
		
		
	}
}

