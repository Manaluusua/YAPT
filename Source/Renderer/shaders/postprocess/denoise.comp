#include "../globalDefinitions.hlsl"
#include "../common/common.hlsl"
#include "../common/commonMath.hlsl"
#include "materialParameterTextures.hlsl"

struct DenoiseParams
{
    float4 textureDimensions;
    uint4 denoiseParams;
};



#define DENOISE_MODE_OFF 0
#define DENOISE_MODE_ON 1
#define DENOISE_MODE_MAT_PARAMS_DEBUG 2
#define DENOISE_MODE_VARIANCE_DEBUG 3
#define DENOISE_SHOW_SAMPLE_SOURCES 4

ConstantBuffer<DenoiseParams> g_denoiseParams : register(b0, space0);
Texture2D g_sourceTex : register(t1, space0);
Texture2D<uint4> g_materialParams0 : register(t2, space0);
Texture2D<uint4> g_materialParams1 : register(t3, space0);
Texture2D<float> g_varianceTex : register(t4, space0);
Texture2D g_lastSamples : register(t5, space0);
RWTexture2D<float4> g_targetTex : register(u6, space0);

#define g_denoiseMode (g_denoiseParams.denoiseParams.x)
#define g_denoiseKernelWidth (g_denoiseParams.denoiseParams.y)
#define g_denoiseTextureSize (g_denoiseParams.textureDimensions.xy)

float4 calculateDebugMaterialParams(uint2 loc)
{
    float2 scaledUv = (loc * g_denoiseParams.textureDimensions.zw) * 2.f;
    uint2 readLocation = frac(scaledUv) * g_denoiseParams.textureDimensions.xy;
    
    MaterialParameters2Texture matParams = readMaterialParametersFromTextures(readLocation, g_materialParams0, g_materialParams1);
    
    if(scaledUv.x < 1)
    {
        if (scaledUv.y < 1)
        {
            return float4(matParams.albedo, 1);
        } 
        else
        {
            return float4(matParams.normal * 0.5f + 0.5f, 1);
        }
    } 
    else
    {
        if (scaledUv.y < 1)
        {
            return float4(matParams.anisotropy, matParams.ior, matParams.roughness, 1.f);
        }
        else
        {
            return float4(matParams.metalness, matParams.depth, matParams.transparency, 1.f);
        }
    }
}

float3 calculateNeighbouringVariance(uint2 location, uint kernelHalfSize)
{
    float minVariance = 999.f;
    float maxVariance = 0.f;
    float avgVariance = 0;
    float samples = 0;
    for (float x = max(location.x - kernelHalfSize, 0); x < min(location.x + kernelHalfSize, g_denoiseTextureSize.x - 1); x++)
    {
        for (float y = max(location.y - kernelHalfSize, 0); y < min(location.y + kernelHalfSize, g_denoiseTextureSize.y - 1); y++)
        {
            float var = g_varianceTex[uint2(x, y)];
            avgVariance += var;
            if(var > maxVariance)
            {
                maxVariance = var;
            }
            if(var < minVariance)
            {
                minVariance = var;
            }
            ++samples;

        }
    }
    avgVariance =  avgVariance / samples;
    return float3(minVariance, maxVariance, avgVariance);
}

float calculateVisualDifferenceAlbedo(float3 a, float3 b)
{
    float3 delta = saturate(abs(a - b));
    return (delta.x + delta.y + delta.z) * 0.3333f;

}

float calculateMaterialParamsDiffWeight(MaterialParameters2Texture a, MaterialParameters2Texture b)
{
    float roughnessDelta = abs(a.roughness - b.roughness);
    float albedoDelta = calculateVisualDifferenceAlbedo(a.albedo, b.albedo);
    float anisoDiff = abs(a.anisotropy - b.anisotropy);
    float depthDelta = abs(a.depth - b.depth);
    float normalDot = saturate(dot(a.normal, b.normal));
    float iorDelta = abs(a.ior - b.ior);
    float metalnessDelta = abs(a.metalness - b.metalness);
    float transparencyDelta = abs(a.transparency - b.transparency);
    
    //TODO: flags
    
    //TODO: figure out better weighting: rejecting first with geometry (depth & normal) and then surface params? 
    float weight = 1.f;
    weight *= 1.f - roughnessDelta;
    weight *= 1.f - albedoDelta;
    weight *= 1.f - anisoDiff;
    weight *= 1.f - smoothstep(0.1, 1, depthDelta);
    weight *= normalDot;
    weight *= 0.5f + 0.5f * (1.f - saturate(iorDelta)); //lessen effect of ior
    weight *= 1.f - metalnessDelta;
    weight *= 1.f - transparencyDelta;
    return weight;

}

float calculateKernelDistanceWeight(float2 deltaFromCenter, float sigma)
{
    return gaussian(deltaFromCenter, sigma);
}

uint floatToUint(float v)
{
    return uint(floor(max(v, 0) + 0.5f));
}

float4 denoise(uint2 loc, bool kernelSizeDrivenByVariance)
{
    MaterialParameters2Texture centerMatParams = readMaterialParametersFromTextures(loc.xy, g_materialParams0, g_materialParams1);
    
    float denoiseKernelHalfSize;
    float minKernelHalfSize = 0;
    float maxKernelHalfSize = 4;
    
    if (kernelSizeDrivenByVariance)
    {
        float3 varMinMaxAvg = calculateNeighbouringVariance(loc.xy, g_denoiseKernelWidth);
        float minKernelVar = 0.0001f;
        float maxKernelVar = 0.01;
        float t = saturate((varMinMaxAvg.y - minKernelVar) / (maxKernelVar - minKernelVar));
        denoiseKernelHalfSize = lerp(minKernelHalfSize, maxKernelHalfSize, t);
    }
    else
    {
        denoiseKernelHalfSize = lerp(minKernelHalfSize, maxKernelHalfSize, saturate(centerMatParams.roughness));
    }

    
    
    float sigma = 0.3f * (denoiseKernelHalfSize - 1.5f) + 0.8f;
    float4 colorOut;
    {
        float4 centerSample = g_sourceTex.Load(uint3(loc.xy, 0));
        
        float weight = 1;
        float4 sampleSum = centerSample;
        if(denoiseKernelHalfSize > 0)
        {
            float2 locf = loc;
            for (float x = max(locf.x - denoiseKernelHalfSize, 0); x < min(locf.x + denoiseKernelHalfSize, g_denoiseTextureSize.x - 1); x++)
            {
                for (float y = max(locf.y - denoiseKernelHalfSize, 0); y < min(locf.y + denoiseKernelHalfSize, g_denoiseTextureSize.y - 1); y++)
                {
                    uint2 sampleLoc = uint2(floatToUint(x), floatToUint(y));
                    if (sampleLoc.x != loc.x || sampleLoc.y != loc.y)
                    {
                        MaterialParameters2Texture matParams = readMaterialParametersFromTextures(sampleLoc, g_materialParams0, g_materialParams1);
                        float matWeight = calculateMaterialParamsDiffWeight(centerMatParams, matParams);
                        float distWeight = calculateKernelDistanceWeight(float2(x, y) - locf.xy, sigma);
                        float sampleWeight = matWeight * distWeight;
                        float4 colorSample = g_sourceTex.Load(uint3(sampleLoc.x, sampleLoc.y, 0));
                        sampleSum += sampleWeight * colorSample;
                        weight += sampleWeight;
                    }
                }
            }
            
            sampleSum /=  weight;
            colorOut = sampleSum;

        }
        else
        {
            colorOut = centerSample;
        }

    }
    
    
     
    return colorOut; //TODO
}

