#include "../globalDefinitions.hlsl"
#include "../common/common.hlsl"
#include "../common/colorSpaces.hlsl"

struct MergeNewSamplesParams
{
	uint4 targetTextureOffsetScaleBias;
    uint4 randomSequence;
	uint2 targetTextureDimensions;
	uint2 sourceTextureDimensions;
	uint64_t sampleCount;
    uint accumulationTargetCount;
	
};

ConstantBuffer<MergeNewSamplesParams> g_mergeParams : register(b0, space0);
RWTexture2D<float4> g_mergedResTex : register(u1, space0);
RWTexture2DArray<float4> g_accumTex : register(u2, space0);
RWTexture2D<uint> g_sampleCountsTex : register(u3, space0);
RWTexture2D<float> g_varianceTex : register(u4, space0);
Texture2D g_newSamples : register(t5, space0);

#define GET_RANDOM_NUMBER_SEQUENCE_1(dimOffset) (g_mergeParams.randomSequence.x)
#define GET_RANDOM_NUMBER_SEQUENCE_2(dimOffset) (g_mergeParams.randomSequence.xy)
#define GET_RANDOM_NUMBER_SEQUENCE_3(dimOffset) (g_mergeParams.randomSequence.xyz)
#define GET_RANDOM_NUMBER_SEQUENCE_4(dimOffset) (g_mergeParams.randomSequence.xyxw)
#include "../common/randomSampler.hlsl"

#define USE_PER_PIXEL_SAMPLE_COUNT
#define NEAREST_SAMPLE_MERGE



void calculateSampleContribution(uint2 targetPos, out float4 colorOut, out float weightOut)
{
#ifdef NEAREST_SAMPLE_MERGE
	//TODO
    uint2 samplePos = g_mergeParams.targetTextureOffsetScaleBias.zw + targetPos / g_mergeParams.targetTextureOffsetScaleBias.xy;
    weightOut = 1;
    if (all(samplePos == targetPos))
    {
        colorOut = g_newSamples[samplePos];
    } 
	else
    {
        colorOut = 0;
    }
#else

	//need random here, TODO
    float4 colorSum = 0;
	float2 toSrcTexMult = float2(1.f, 1.f) / g_mergeParams.targetTextureOffsetScaleBias.xy;
    float2 center = targetPos.xy + 0.5f;
    for (float x = max(targetPos.x - 1, 0) + g_mergeParams.targetTextureOffsetScaleBias.z; x < min(targetPos.x + 1, g_mergeParams.targetTextureDimensions.x - 1); x += g_mergeParams.targetTextureOffsetScaleBias.x)
    {
        for (float y = max(targetPos.y - 1, 0) + g_mergeParams.targetTextureOffsetScaleBias.w; y < min(targetPos.y + 1, g_mergeParams.targetTextureDimensions.y - 1); y += g_mergeParams.targetTextureOffsetScaleBias.y)
        {
            RandomSampler rand;
            rand.init(0, y * g_mergeParams.targetTextureDimensions.x + x);
            float2 samplePosFullres = float2(x, y) + rand.getTexelOffset();
            float2 d = abs(samplePosFullres - center);
            float2 weights = saturate(float2(1.f, 1.f) - d);
            float weight = weights.x * weights.y;
			if(weight > 0)
            {
                uint2 samplePos  = (uint2)floor(float2(x, y) * toSrcTexMult);
                float4 color = g_newSamples[samplePos];
                colorSum += color * weight;
            }
			
			
        }
    }
    colorOut = colorSum;
#endif
    
	
	
}

float toPerceptualDiff(float3 color)
{
    return (color.x + color.y + color.z) * 0.33333; //TODO
}

[numthreads(8, 8, 1)]
void main( uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex )
{
    if (dispatchThreadId.x < g_mergeParams.targetTextureDimensions.x && dispatchThreadId.y < g_mergeParams.targetTextureDimensions.y)
	{
        uint2 targetPosition = dispatchThreadId.xy;
        float4 srcColor;
        float weight;
		calculateSampleContribution(targetPosition, srcColor, weight);
		
        uint oldSamples = 0;
        uint newSamples = 0;
        
#ifdef USE_PER_PIXEL_SAMPLE_COUNT
        newSamples = srcColor.a;
        
        if (newSamples > 0)
		{
            oldSamples = g_sampleCountsTex[targetPosition];
            g_sampleCountsTex[targetPosition] = newSamples + oldSamples;
        }
#else
		if(srcColor.a > 0)
		{
            newSamples = 1;
            oldSamples = g_mergeParams.sampleCount;
		}
#endif
        uint accumLayer = g_mergeParams.sampleCount % g_mergeParams.accumulationTargetCount;
        if(newSamples > 0)
        {
            uint3 targetTexCoord = uint3(targetPosition.x, targetPosition.y, accumLayer);
            
            oldSamples = oldSamples / g_mergeParams.accumulationTargetCount;
            float4 dstColor = g_accumTex[targetTexCoord];
            double totalSamples = newSamples + oldSamples;
            double destBlend = oldSamples / totalSamples;
            double srcBlend = newSamples / totalSamples;
			
            float4 output = float4(dstColor.xyz * destBlend + srcBlend * srcColor.xyz, 1);
            g_accumTex[targetTexCoord] = output;

        }
        uint3 targetTexCoord = uint3(targetPosition.x, targetPosition.y, 0);
        float3 resultSum = g_accumTex[targetTexCoord].xyz;
        //TODO: make chromaticity also account for something
        float compareLuminance = resultSum.y;
        compareLuminance = log(1.f + compareLuminance);
        float variance = 0;
        uint accumTargets = min(g_mergeParams.sampleCount + 1, g_mergeParams.accumulationTargetCount);
        for (uint i = 1; i < accumTargets; ++i)
        {
            targetTexCoord = uint3(targetPosition.x, targetPosition.y, i);
            float3 r = g_accumTex[targetTexCoord].xyz;
            resultSum += r;
            
            float lum = r.y;
            lum = log(1.f + lum);
            float d = abs(compareLuminance - lum);
            variance += d * d;
        }
        resultSum /= accumTargets;
        variance /= accumTargets;
        resultSum = mul(c_srgbXYZToRGB, resultSum);
        g_mergedResTex[targetPosition] = float4(resultSum, 1.f);
        
        if (g_mergeParams.sampleCount == 0)
        {
            g_varianceTex[targetPosition] = 0;

        }
        else
        {
            g_varianceTex[targetPosition] = variance;
        }
        
		
	}
}

